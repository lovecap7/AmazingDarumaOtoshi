  m_title: "\u304A\u76C6\u306E\u4E0A"
  m_concept: "\u3061\u3083\u3076\u53F0\u306B\u7F6E\u304B\u308C\u305F\u304A\u76C6\u306E\u4E0A\u3002\u7E01\u304C\u58C1\u306B\u306A\u3063\u305F\u95D8\u6280\u5834\u3067\u3001\u6E6F\u5451\u307F\u306E\u3088\u3046\u306B\u4E26\u3093\u30604\u3064\u306E\u30D0\u30F3\u30D1\u30FC\u304C\u4E2D\u592E\u306E\u88DC\u7D66\u6240\u3092\u56F2\u3080\u3002"
