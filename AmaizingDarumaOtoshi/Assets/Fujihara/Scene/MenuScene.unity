    choiceHelps:
    - "1\u53F0\u306E\u30D1\u30BD\u30B3\u30F3\u306B\u30B3\u30F3\u30C8\u30ED\u30FC\u30E9\u30FC\u3092\u3064\u306A\u3044\u3067\u3001\u6700\u59274\u4EBA\u3067\u904A\u3073\u307E\u3059\u3002CPU \u3082\u53C2\u52A0\u3067\u304D\u307E\u3059\u3002"
