  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Nakagawa.StageInfo
  m_id: Stage01
  m_title: "\u304A\u76C6\u306E\u4E0A"
  m_concept: "\u3061\u3083\u3076\u53F0\u306B\u7F6E\u304B\u308C\u305F\u304A\u76C6\u306E\u4E0A\u3002\u7E01\u304C\u58C1\u306B\u306A\u3063\u305F\u95D8\u6280\u5834\u3067\u3001\u6E6F\u5451\u307F\u306E\u3088\u3046\u306B\u4E26\u3093\u30604\u3064\u306E\u30D0\u30F3\u30D1\u30FC\u304C\u4E2D\u592E\u306E\u88DC\u7D66\u6240\u3092\u56F2\u3080\u3002"
  m_expectedFlow: "\u56DB\u65B9\u306E\u7E01(\u58C1)\u3067\u5F3E\u304C\u8DF3\u306D\u8FD4\u308B\u306E\u3067\u3001\u3069\u3053\u306B\u3044\u3066\u3082\u8DF3\u5F3E\u304C\u98DB\u3093\u3067\u304F\u308B\u3002\u4E2D\u592E\u306E\u88DC\u7D66\u6240\u3078\u306F\u30D0\u30F3\u30D1\u30FC\u306E\u9593\u3092\u629C\u3051\u3066\u5165\u308B\u3053\u3068\u306B\u306A\u308A\u3001\u306F\u3058\u304B\u308C\u305F\u5F3E\u3084\u4F53\u304C\u601D\u308F\u306C\u65B9\u5411\u3078\u98DB\u3076\u3002\u304A\u8336\u306E\u9593\u30B7\u30EA\u30FC\u30BA\u306E\u5165\u9580\u3068\u3057\u3066\u3001\u57FA\u672C\u306E\u6483\u3061\u5408\u3044\u3068\u30D0\u30F3\u30D1\u30FC\u306E\u4F7F\u3044\u65B9\u3092\u899A\u3048\u308B\u821E\u53F0\u3002"
  m_layout: "\u5E83\u3055: 26\xD722m\n\u30AE\u30DF\u30C3\u30AF: \u30D0\u30F3\u30D1\u30FC\xD74\n\u751F\u6210\u30A8\u30EA\u30A2: 7\u304B\u6240(\u5186\u5F62 \u534A\u5F843.5\u3001\u5186\u5F62 \u534A\u5F841.8\u3001\u5186\u5F62 \u534A\u5F841.8\u3001\u5186\u5F62 \u534A\u5F841.8\u3001\u5186\u5F62 \u534A\u5F841.8\u3001\u77E9\u5F624\xD73\u3001\u77E9\u5F624\xD73)\n\u76E4\u9762\u306E\u7A4D\u307F\u6728\u306E\u4E0A\u9650: 24\u500B"
