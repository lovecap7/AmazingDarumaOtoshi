  m_id: DebugStage34
  m_title: "\u7A93\u304B\u3089\u306E\u98A8"
  m_concept: "\u5357\u306E\u58C1\u306E\u4E2D\u592E\u3060\u3051\u304C\u958B\u3044\u305F\u7A93\u306B\u306A\u3063\u3066\u3044\u308B\u90E8\u5BA4\u3002\u5317\u306E\u58C1\u969B\u306E\u6247\u98A8\u6A5F\u304C\u6771\u897F\u3078\u5F80\u5FA9\u3057\u306A\u304C\u3089\u3001\u7A93\u3078\u5411\u3051\u3066\u98A8\u3092\u9001\u308B\u3002\u7A93\u306E\u524D\u306B\u30D0\u30F3\u30D1\u30FC\u304C\u4E8C\u3064\u3002"
  m_expectedFlow: "\u98A8\u306F\u7A93\u3078\u5411\u3051\u3066\u5439\u304F\u306E\u3067\u3001\u7A93\u306E\u524D\u3067\u6483\u3061\u5408\u3046\u3068\u62BC\u3057\u51FA\u3055\u308C\u3066\u843D\u3061\u308B\u3002\u7A93\u306E\u4E21\u8107\u306F\u58C1\u304C\u6B8B\u3063\u3066\u3044\u3066\u3001\u98A8\u3092\u53D7\u3051\u3066\u3082\u843D\u3061\u306A\u3044\u5B89\u5168\u5730\u5E2F\u3002\u7A93\u306E\u524D\u306E\u88DC\u7D66\u6240\u306F\u7A4D\u307F\u6728\u304C\u591A\u3044\u304C\u3001\u30D0\u30F3\u30D1\u30FC\u306B\u306F\u3058\u304B\u308C\u3066\u98A8\u306B\u4E57\u308B\u3068\u7A93\u306E\u5916\u3078\u4E00\u76F4\u7DDA\u3002\u6247\u98A8\u6A5F\u306E\u5F80\u5FA9\u3092\u898B\u3066\u3001\u98A8\u304C\u6765\u306A\u3044\u9593\u306B\u62FE\u3046\u3002"
  m_layout: "\u5E83\u3055: 28\xD719m\n\u30AE\u30DF\u30C3\u30AF: \u6247\u98A8\u6A5F\xD71\u3001\u30D0\u30F3\u30D1\u30FC\xD72\n\u751F\u6210\u30A8\u30EA\u30A2: 6\u304B\u6240(\u77E9\u5F628\xD73\u3001\u5186\u5F62 \u534A\u5F841.8\u3001\u5186\u5F62 \u534A\u5F841.2\u3001\u5186\u5F62 \u534A\u5F841.2\u3001\u77E9\u5F622\xD74\u3001\u77E9\u5F622\xD74)\n\u76E4\u9762\u306E\u7A4D\u307F\u6728\u306E\u4E0A\u9650: 22\u500B"
