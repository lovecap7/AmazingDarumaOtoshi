  m_title: "\u98A8\u306E\u8981\u585E"
  m_concept: "\u56DB\u9685\u306E\u6247\u98A8\u6A5F\u304C\u58C1\u6CBF\u3044\u306B\u98A8\u3092\u9001\u308A\u3001\u5916\u5468\u3092\u3050\u308B\u308A\u3068\u56DE\u308B\u98A8\u306E\u74B0\u304C\u3067\u304D\u305F\u95D8\u6280\u5834\u3002"
  m_expectedFlow: "\u5916\u5468\u306B\u8FD1\u3065\u304F\u3068\u6642\u8A08\u56DE\u308A\u306B\u6D41\u3055\u308C\u3001\u5916\u5468\u3092\u901A\u308B\u5F3E\u3082\u98A8\u306B\u4E57\u3063\u3066\u5468\u56DE\u3059\u308B\u3088\u3046\u306B\u66F2\u304C\u308B\u3002\u98A8\u306E\u74B0\u306E\u5185\u5074\u306F\u7121\u98A8\u3067\u3001\u4E2D\u592E\u306E\u88DC\u7D66\u6240\u3092\u5DE1\u308B\u6226\u3044\u306B\u306A\u308B\u3002\u5916\u5468\u306B\u62BC\u3057\u51FA\u3055\u308C\u305F\u76F8\u624B\u306F\u6D41\u3055\u308C\u3066\u4F53\u52E2\u3092\u5D29\u3059\u306E\u3067\u3001\u5185\u5074\u304B\u3089\u5916\u5468\u3078\u8FFD\u3044\u51FA\u3059\u653B\u3081\u304C\u6709\u52B9\u3002"
  m_layout: "\u5E83\u3055: 30\xD730m\n\u30AE\u30DF\u30C3\u30AF: \u6247\u98A8\u6A5F\xD74\n\u751F\u6210\u30A8\u30EA\u30A2: 7\u304B\u6240(\u5186\u5F62 \u534A\u5F844\u3001\u77E9\u5F626\xD73\u3001\u77E9\u5F626\xD73\u3001\u77E9\u5F623\xD76\u3001\u77E9\u5F623\xD76\u3001\u5186\u5F62 \u534A\u5F842\u3001\u5186\u5F62 \u534A\u5F842)\n\u76E4\u9762\u306E\u7A4D\u307F\u6728\u306E\u4E0A\u9650: 26\u500B"
