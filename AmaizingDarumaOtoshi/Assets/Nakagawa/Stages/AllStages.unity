  m_title: "\u4EBA\u5DE5\u91CD\u529B\u30EA\u30F3\u30B0"
  m_concept: "\u5E8A\u306E\u5927\u534A\u3092\u5360\u3081\u308B\u4EBA\u5DE5\u91CD\u529B\u306E\u30EA\u30F3\u30B0(\u56DE\u8EE2\u53F0)\u304C\u3086\u3063\u304F\u308A\u56DE\u308B\u3002\u56DB\u9685\u306B\u306F\u63A8\u9032\u88C5\u7F6E\u306E\u52A0\u901F\u5E8A\u3002"
  m_expectedFlow: "\u30EA\u30F3\u30B0\u306E\u4E0A\u3067\u306F\u5F3E\u304C\u3086\u3063\u304F\u308A\u66F2\u304C\u308A\u7D9A\u3051\u3001\u9060\u304F\u306E\u76F8\u624B\u307B\u3069\u5F53\u3066\u306B\u304F\u3044\u3002\u56DB\u9685\u306E\u52A0\u901F\u5E8A\u3067\u52E2\u3044\u3092\u3064\u3051\u3066\u98DB\u3073\u51FA\u3059\u3068\u3001\u30EA\u30F3\u30B0\u306E\u4E0A\u3092\u4E00\u6C17\u306B\u6A2A\u5207\u308C\u308B\u3002\u30EA\u30F3\u30B0\u4E2D\u592E\u306E\u88DC\u7D66\u6240\u306F\u56DE\u308A\u306A\u304C\u3089\u5916\u3078\u904B\u3070\u308C\u3066\u3044\u304F\u3002"
  m_layout: "\u5E83\u3055: 28\xD728m\n\u30AE\u30DF\u30C3\u30AF: \u56DE\u8EE2\u53F0\xD71\u3001\u52A0\u901F\u5E8A\xD74\n\u751F\u6210\u30A8\u30EA\u30A2: 6\u304B\u6240(\u5186\u5F62 \u534A\u5F842\u3001\u5186\u5F62 \u534A\u5F841.2\u3001\u5186\u5F62 \u534A\u5F841.2\u3001\u77E9\u5F626\xD73\u3001\u77E9\u5F626\xD73\u3001\u77E9\u5F623\xD76)\n\u76E4\u9762\u306E\u7A4D\u307F\u6728\u306E\u4E0A\u9650: 24\u500B"
