  m_Script: {fileID: 11500000, guid: 2e7d0403be9a2b0418d7666136698b95, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Nakagawa.StageInfo
  m_id: DebugStage45
  m_title: "\u4E2D\u5EAD\u306E\u7A3D\u53E4\u5834"
  m_concept: "\u6771\u897F\u4E8C\u3064\u306E\u4E2D\u5EAD(\u5948\u843D)\u3092\u56F2\u3080\u7A3D\u53E4\u5834\u3002\u4E2D\u5EAD\u306E\u9593\u3092\u5357\u5317\u306B\u6E21\u308A\u5ECA\u4E0B\u304C\u901A\u308A\u3001\u4E2D\u5EAD\u306E\u4E2D\u3067\u306F\u677F(\u79FB\u52D5\u5E8A)\u304C\u6771\u897F\u306B\u5F80\u5FA9\u3057\u3066\u3001\u6E21\u308A\u5ECA\u4E0B\u3068\u5916\u5074\u306E\u7E01\u5074\u3092\u3064\u306A\u3050\u3002\u4E2D\u5EAD\u306E\u89D2\u306B\u30D0\u30F3\u30D1\u30FC\u3002"
  m_expectedFlow: "\u3069\u3053\u3082\u5730\u7D9A\u304D\u3067\u3001\u5317\u3068\u5357\u306E\u7A3D\u53E4\u5834\u306F\u6E21\u308A\u5ECA\u4E0B\u304B\u5916\u5074\u306E\u7E01\u5074\u3092\u901A\u3063\u3066\u884C\u304D\u6765\u3059\u308B\u3002\u4E2D\u5EAD\u306E\u677F\u306F\u6E21\u308A\u5ECA\u4E0B\u3068\u7E01\u5074\u306E\u4E21\u65B9\u306B\u5C4A\u304F\u8FD1\u9053\u3060\u304C\u3001\u677F\u306E\u5357\u5317\u306F\u7A74\u306A\u306E\u3067\u3001\u4E57\u3063\u3066\u3044\u308B\u6240\u3092\u6483\u305F\u308C\u308B\u3068\u843D\u3061\u308B\u3002\u4E2D\u5EAD\u306E\u89D2\u306E\u30D0\u30F3\u30D1\u30FC\u306F\u3001\u7E01\u3092\u6B69\u304F\u76F8\u624B\u3092\u4E2D\u5EAD\u3078\u306F\u3058\u304D\u843D\u3068\u3059\u3002\u6E21\u308A\u5ECA\u4E0B\u306E\u88DC\u7D66\u6240\u306F\u56DB\u65B9\u304B\u3089\u72D9\u308F\u308C\u308B\u6FC0\u6226\u533A\u3002"
  m_layout: "\u5E83\u3055: 30\xD724m\n\u30AE\u30DF\u30C3\u30AF: \u30D0\u30F3\u30D1\u30FC\xD72\u3001\u79FB\u52D5\u5E8A\xD72\n\u751F\u6210\u30A8\u30EA\u30A2: 7\u304B\u6240(\u5186\u5F62 \u534A\u5F842\u3001\u5186\u5F62 \u534A\u5F841.2\u3001\u5186\u5F62 \u534A\u5F841.2\u3001\u5186\u5F62 \u534A\u5F841.2\u3001\u5186\u5F62 \u534A\u5F841.2\u3001\u77E9\u5F628\xD72.5\u3001\u77E9\u5F628\xD72.5)\n\u76E4\u9762\u306E\u7A4D\u307F\u6728\u306E\u4E0A\u9650: 24\u500B"
