  m_expectedFlow: "\u7A74\u306E\u5357\u5317\u306E\u7E01\u306F\u88DC\u7D66\u6240\u3067\u3001\u62FE\u3063\u3066\u3044\u308B\u3068\u3053\u308D\u3092\u6483\u305F\u308C\u308B\u3068\u7A74\u3078\u843D\u3061\u308B\u3002\u677F\u306F\u7A74\u306E\u6771\u897F\u306E\u7AEF\u307E\u3067\u5C4A\u304F\u306E\u3067\u8FD1\u9053\u306B\u4F7F\u3048\u308B\u304C\u3001\u4E57\u3063\u3066\u3044\u308B\u9593\u306F\u5357\u5317\u306E\u7E01\u304B\u3089\u72D9\u3044\u6483\u3061\u3055\u308C\u308B\u3002\u30EF\u30FC\u30D7\u30B2\u30FC\u30C8\u3067\u53CD\u5BFE\u5074\u3078\u56DE\u308A\u8FBC\u3081\u308B\u3082\u306E\u306E\u3001\u51FA\u53E3\u3067\u5F85\u3061\u4F0F\u305B\u3055\u308C\u3084\u3059\u3044\u3002"
  m_layout: "\u5E83\u3055: 30\xD724m\n\u30AE\u30DF\u30C3\u30AF: \u79FB\u52D5\u5E8A\xD71\u3001\u30EF\u30FC\u30D7\u30B2\u30FC\u30C8\xD72\n\u751F\u6210\u30A8\u30EA\u30A2: 6\u304B\u6240(\u77E9\u5F628\xD72.5\u3001\u77E9\u5F628\xD72.5\u3001\u5186\u5F62 \u534A\u5F841.5\u3001\u5186\u5F62 \u534A\u5F841.5\u3001\u5186\u5F62 \u534A\u5F841\u3001\u5186\u5F62 \u534A\u5F841)\n\u76E4\u9762\u306E\u7A4D\u307F\u6728\u306E\u4E0A\u9650: 24\u500B"
