  m_concept: "\u5357\u5074\u3060\u3051\u58C1\u306E\u306A\u3044\u6D17\u3044\u5834\u3002\u5357\u5BC4\u308A\u306E\u6392\u6C34\u53E3\u306E\u6E26(\u9AD8\u901F\u306E\u56DE\u8EE2\u53F0)\u304C\u3001\u8FD1\u3065\u3044\u305F\u7269\u3092\u5DFB\u304D\u8FBC\u3093\u3067\u6D41\u3059\u3002"
