  m_id: Stage04
  m_title: "\u681E\u306E\u6A4B"
  m_concept: "\u958B\u3044\u305F\u4E8C\u518A\u306E\u672C\u3092\u4E00\u672C\u306E\u681E\u304C\u3064\u306A\u3050\u3002\u672C\u306E\u5916\u5074\u306F\u58C1\u3001\u681E\u306E\u4E21\u5074\u306F\u5D16\u3002\u681E\u306E\u5165\u53E3\u3092\u30D0\u30F3\u30D1\u30FC\u304C\u56FA\u3081\u308B\u3002"
  m_expectedFlow: "\u88DC\u7D66\u6240\u306F\u305D\u308C\u305E\u308C\u306E\u672C\u306E\u4E21\u7AEF\u306B\u3042\u308B\u306E\u3067\u3001\u5E8F\u76E4\u306F\u81EA\u5206\u306E\u672C\u306E\u4E0A\u3067\u7A4D\u307F\u6728\u3092\u96C6\u3081\u308B\u6483\u3061\u5408\u3044\u3002\u76F8\u624B\u306E\u672C\u3078\u653B\u3081\u8FBC\u3080\u306B\u306F\u7D30\u3044\u681E\u3092\u6E21\u308B\u3057\u304B\u306A\u304F\u3001\u5165\u53E3\u306E\u30D0\u30F3\u30D1\u30FC\u306B\u306F\u3058\u304B\u308C\u308B\u3068\u5D16\u3078\u843D\u3061\u308B\u5371\u967A\u304C\u3042\u308B\u3002\u681E\u306E\u4E0A\u3067\u306E\u6483\u3061\u5408\u3044\u3068\u3001\u5165\u53E3\u3067\u306E\u62BC\u3057\u5408\u3044\u304C\u5C71\u5834\u3002"
  m_layout: "\u5E83\u3055: 30\xD726m\n\u30AE\u30DF\u30C3\u30AF: \u30D0\u30F3\u30D1\u30FC\xD74\n\u751F\u6210\u30A8\u30EA\u30A2: 7\u304B\u6240(\u77E9\u5F626\xD74\u3001\u77E9\u5F626\xD74\u3001\u77E9\u5F626\xD74\u3001\u77E9\u5F626\xD74\u3001\u77E9\u5F6210\xD75\u3001\u5186\u5F62 \u534A\u5F841.6\u3001\u5186\u5F62 \u534A\u5F841.6)\n\u76E4\u9762\u306E\u7A4D\u307F\u6728\u306E\u4E0A\u9650: 26\u500B"
