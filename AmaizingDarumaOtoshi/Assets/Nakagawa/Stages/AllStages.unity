  m_expectedFlow: "\u6E26\u5DFB\u304D\u306E\u901A\u8DEF\u306F\u7D30\u304F\u3001\u4ED5\u5207\u308A\u3067\u5F3E\u304C\u4F55\u5EA6\u3082\u8DF3\u306D\u8FD4\u308B\u3002\u4E2D\u5FC3\u3078\u884C\u304F\u306B\u306F\u901A\u8DEF\u3092\u56DE\u308A\u8FBC\u3080\u5FC5\u8981\u304C\u3042\u308A\u3001\u5916\u5468\u306E\u88DC\u7D66\u6240\u3067\u96C6\u3081\u3066\u304B\u3089\u4E2D\u5FC3\u3092\u76EE\u6307\u3059\u306E\u304C\u57FA\u672C\u3002\u66F2\u304C\u308A\u89D2\u306E\u5148\u3067\u306E\u9262\u5408\u308F\u305B\u3068\u3001\u58C1\u8D8A\u3057\u306E\u8DF3\u5F3E\u304C\u898B\u3069\u3053\u308D\u3002"
  m_layout: "\u5E83\u3055: 28\xD728m\n\u30AE\u30DF\u30C3\u30AF: \u30D0\u30F3\u30D1\u30FC\xD72\n\u751F\u6210\u30A8\u30EA\u30A2: 6\u304B\u6240(\u5186\u5F62 \u534A\u5F842.5\u3001\u77E9\u5F628\xD74\u3001\u77E9\u5F624\xD76\u3001\u77E9\u5F626\xD74\u3001\u77E9\u5F624\xD74\u3001\u5186\u5F62 \u534A\u5F841.8)\n\u76E4\u9762\u306E\u7A4D\u307F\u6728\u306E\u4E0A\u9650: 24\u500B"
