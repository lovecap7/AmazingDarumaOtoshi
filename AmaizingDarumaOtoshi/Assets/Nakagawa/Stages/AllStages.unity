  m_expectedFlow: "\u98A8\u306E\u901A\u308A\u9053\u304C\u5DE6\u53F3\u306B\u52D5\u304D\u7D9A\u3051\u308B\u306E\u3067\u3001\u5357\u5317\u306E\u5D16\u969B\u306B\u7ACB\u3064\u3068\u98A8\u306B\u62BC\u3055\u308C\u3066\u843D\u3061\u308B\u5371\u967A\u304C\u3042\u308B\u3002\u88DC\u7D66\u6240\u306F\u98A8\u306E\u6765\u306A\u3044\u6771\u897F\u306E\u58C1\u969B\u3002\u6247\u98A8\u6A5F\u306E\u5F80\u5FA9\u3092\u8AAD\u3093\u3067\u98A8\u306E\u5207\u308C\u76EE\u3092\u6E21\u308A\u3001\u53CD\u5BFE\u5074\u306E\u88DC\u7D66\u6240\u3078\u653B\u3081\u8FBC\u3080\u30BF\u30A4\u30DF\u30F3\u30B0\u304C\u52DD\u8CA0\u3092\u5206\u3051\u308B\u3002"
  m_layout: "\u5E83\u3055: 26\xD724m\n\u30AE\u30DF\u30C3\u30AF: \u6247\u98A8\u6A5F\xD72\n\u751F\u6210\u30A8\u30EA\u30A2: 7\u304B\u6240(\u77E9\u5F623\xD710\u3001\u77E9\u5F623\xD710\u3001\u77E9\u5F628\xD73\u3001\u77E9\u5F628\xD73\u3001\u77E9\u5F624\xD78\u3001\u5186\u5F62 \u534A\u5F841.5\u3001\u5186\u5F62 \u534A\u5F841.5)\n\u76E4\u9762\u306E\u7A4D\u307F\u6728\u306E\u4E0A\u9650: 22\u500B"
