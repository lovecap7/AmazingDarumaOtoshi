  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Nakagawa.StageInfo
  m_id: DebugStage60
  m_title: "\u6FE1\u308C\u305F\u7532\u677F\u306E\u8377\u63DA\u3052"
  m_concept: "\u5357\u5317\u306E\u30AF\u30EC\u30FC\u30F3(\u56DE\u8EE2\u7832\u53F0)\u304C\u9996\u3092\u632F\u308A\u306A\u304C\u3089\u8377\u7269(\u7A4D\u307F\u6728)\u3092\u7532\u677F\u3078\u964D\u308D\u3059\u3002\u7532\u677F\u306E\u4E2D\u592E\u306F\u6FE1\u308C\u3066\u6ED1\u308B\u52A0\u901F\u5E8A\u3002"
  m_expectedFlow: "\u30AF\u30EC\u30FC\u30F3\u304B\u3089\u6247\u72B6\u306B\u3070\u3089\u307E\u304B\u308C\u305F\u7A4D\u307F\u6728\u304C\u4E2D\u592E\u3078\u96C6\u307E\u308A\u3001\u6FE1\u308C\u305F\u7532\u677F\u306E\u4E0A\u3067\u52DD\u624B\u306B\u6ED1\u3063\u3066\u3044\u304F\u3002\u4E2D\u592E\u306B\u7ACB\u3064\u3068\u4E21\u65B9\u306E\u30AF\u30EC\u30FC\u30F3\u306E\u6D41\u308C\u5F3E\u3092\u6D74\u3073\u308B\u3002\u56DB\u9685\u306E\u88DC\u7D66\u6240\u3067\u96C6\u3081\u3064\u3064\u3001\u6ED1\u3063\u3066\u304F\u308B\u7A4D\u307F\u6728\u3092\u6A2A\u53D6\u308A\u3059\u308B\u3002"
  m_layout: "\u5E83\u3055: 30\xD724m\n\u30AE\u30DF\u30C3\u30AF: \u52A0\u901F\u5E8A\xD72\u3001\u56DE\u8EE2\u7832\u53F0\xD72\n\u751F\u6210\u30A8\u30EA\u30A2: 6\u304B\u6240(\u5186\u5F62 \u534A\u5F842\u3001\u5186\u5F62 \u534A\u5F842\u3001\u5186\u5F62 \u534A\u5F842\u3001\u5186\u5F62 \u534A\u5F842\u3001\u77E9\u5F623\xD76\u3001\u77E9\u5F623\xD76)\n\u76E4\u9762\u306E\u7A4D\u307F\u6728\u306E\u4E0A\u9650: 24\u500B"
