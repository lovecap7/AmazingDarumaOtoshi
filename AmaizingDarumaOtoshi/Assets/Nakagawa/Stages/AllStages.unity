  m_concept: "\u6771\u897F\u306B\u9006\u56DE\u308A\u306E\u56DE\u8EE2\u53F0\u3092\u4E8C\u3064\u4E26\u3079\u305F\u95D8\u6280\u5834\u3002\u88DC\u7D66\u6240\u306F\u5404\u56DE\u8EE2\u53F0\u306E\u4E2D\u5FC3\u3068\u3001\u4E8C\u3064\u306E\u9593\u3002"
  m_expectedFlow: "\u897F\u306F\u6642\u8A08\u56DE\u308A\u3001\u6771\u306F\u53CD\u6642\u8A08\u56DE\u308A\u306A\u306E\u3067\u3001\u53F0\u306E\u4E0A\u3067\u5F3E\u304C\u66F2\u304C\u308B\u5411\u304D\u304C\u5DE6\u53F3\u3067\u9006\u306B\u306A\u308B\u3002\u9593\u306E\u88DC\u7D66\u6240\u306F\u4E21\u65B9\u306E\u53F0\u306B\u631F\u307E\u308C\u3001\u53D6\u308A\u306B\u884C\u304F\u3068\u4E21\u5074\u304B\u3089\u66F2\u304C\u308B\u5F3E\u304C\u98DB\u3093\u3067\u304F\u308B\u6FC0\u6226\u533A\u3002\u56DE\u8EE2\u306E\u5411\u304D\u3092\u899A\u3048\u3066\u5F3E\u306E\u66F2\u304C\u308A\u3092\u5229\u7528\u3067\u304D\u308B\u304B\u304C\u52DD\u8CA0\u3092\u5206\u3051\u308B\u3002"
  m_layout: "\u5E83\u3055: 34\xD724m\n\u30AE\u30DF\u30C3\u30AF: \u56DE\u8EE2\u53F0\xD72\n\u751F\u6210\u30A8\u30EA\u30A2: 3\u304B\u6240(\u5186\u5F62 \u534A\u5F842.5\u3001\u5186\u5F62 \u534A\u5F842.5\u3001\u77E9\u5F623\xD78)\n\u76E4\u9762\u306E\u7A4D\u307F\u6728\u306E\u4E0A\u9650: 28\u500B"
