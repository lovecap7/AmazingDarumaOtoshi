  m_title: "\u7832\u53F0\u306E\u7826"
  m_concept: "\u6771\u897F\u306B\u5411\u304B\u3044\u5408\u3046\u4E8C\u57FA\u306E\u56DE\u8EE2\u7832\u53F0\u304C\u9996\u3092\u632F\u308A\u306A\u304C\u3089\u7A4D\u307F\u6728\u3092\u6483\u3061\u51FA\u3059\u3002\u4E2D\u592E\u306E\u5357\u5317\u306E\u7DDA\u306B\u306F\u3001\u6CE2\u306E\u3088\u3046\u306B\u7ACB\u3061\u4E0A\u304C\u308B\u305B\u308A\u4E0A\u304C\u308A\u5840\u3002"
  m_expectedFlow: "\u7832\u53F0\u306F\u6301\u3061\u4E3B\u306A\u3057\u306E\u5F3E\u3092\u6247\u72B6\u306B\u3070\u3089\u307E\u304F\u306E\u3067\u3001\u8AB0\u306E\u624B\u67C4\u306B\u3082\u306A\u3089\u306A\u3044\u6D41\u308C\u5F3E\u304C\u5E38\u306B\u98DB\u3073\u4EA4\u3046\u3002\u4E2D\u592E\u306E\u5840\u304C\u7ACB\u3063\u3066\u3044\u308B\u9593\u306F\u53CD\u5BFE\u5074\u306E\u7832\u53F0\u306E\u5F3E\u304C\u9632\u304C\u308C\u3001\u4E0B\u304C\u3063\u305F\u6240\u304B\u3089\u306F\u5F3E\u304C\u629C\u3051\u3066\u304F\u308B\u3002\u5840\u306E\u52D5\u304D\u3092\u898B\u3066\u3001\u7832\u53F0\u306E\u5F3E\u304B\u3089\u8EAB\u3092\u96A0\u3057\u3064\u3064\u7A4D\u307F\u6728\u3092\u96C6\u3081\u308B\u7ACB\u3061\u56DE\u308A\u304C\u6C42\u3081\u3089\u308C\u308B\u3002"
  m_layout: "\u5E83\u3055: 32\xD728m\n\u30AE\u30DF\u30C3\u30AF: \u305B\u308A\u4E0A\u304C\u308A\u5840\xD710\u3001\u56DE\u8EE2\u7832\u53F0\xD72\n\u751F\u6210\u30A8\u30EA\u30A2: 6\u304B\u6240(\u5186\u5F62 \u534A\u5F842\u3001\u5186\u5F62 \u534A\u5F842\u3001\u5186\u5F62 \u534A\u5F842\u3001\u5186\u5F62 \u534A\u5F842\u3001\u77E9\u5F623\xD76\u3001\u77E9\u5F623\xD76)\n\u76E4\u9762\u306E\u7A4D\u307F\u6728\u306E\u4E0A\u9650: 26\u500B"
