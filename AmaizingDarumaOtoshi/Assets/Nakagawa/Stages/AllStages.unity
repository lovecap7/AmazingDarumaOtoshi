  m_title: "\u30C8\u30E9\u30C3\u30AF\u306E\u5468\u56DE"
  m_concept: "\u5185\u5074\u306E\u30D5\u30A3\u30FC\u30EB\u30C9\u304C\u5948\u843D\u306B\u306A\u3063\u305F\u3001\u6771\u897F\u306B\u9577\u3044\u30C8\u30E9\u30C3\u30AF\u3002\u5357\u5317\u306E\u76F4\u7DDA\u306B\u52A0\u901F\u5E8A\u3001\u6771\u897F\u306E\u30AB\u30FC\u30D6\u306B\u30D0\u30F3\u30D1\u30FC\u3002"
  m_expectedFlow: "\u30C8\u30E9\u30C3\u30AF\u306E\u5185\u5074\u306F\u5948\u843D\u306A\u306E\u3067\u3001\u76F4\u7DDA\u3067\u6483\u305F\u308C\u308B\u3068\u5185\u5074\u3078\u843D\u3061\u308B\u3002\u52A0\u901F\u5E8A\u3067\u52E2\u3044\u306E\u3064\u3044\u305F\u4F53\u306F\u30AB\u30FC\u30D6\u306E\u30D0\u30F3\u30D1\u30FC\u306B\u306F\u3058\u304B\u308C\u3001\u5185\u5074\u306E\u7A74\u3078\u98DB\u3073\u8FBC\u307F\u304B\u306D\u306A\u3044\u3002\u5185\u5074\u306E\u7E01\u306E\u88DC\u7D66\u6240\u306F\u7A4D\u307F\u6728\u304C\u591A\u3044\u304C\u3001\u53D6\u308A\u306B\u884C\u304F\u306E\u306F\u547D\u304C\u3051\u3002\u5916\u5468\u306E\u58C1\u969B\u3092\u56DE\u3063\u3066\u5B89\u5168\u306B\u96C6\u3081\u308B\u304B\u3001\u5185\u5074\u3067\u52DD\u8CA0\u3059\u308B\u304B\u3002"
  m_layout: "\u5E83\u3055: 34\xD722m\n\u30AE\u30DF\u30C3\u30AF: \u30D0\u30F3\u30D1\u30FC\xD72\u3001\u52A0\u901F\u5E8A\xD72\n\u751F\u6210\u30A8\u30EA\u30A2: 6\u304B\u6240(\u77E9\u5F628\xD72\u3001\u77E9\u5F628\xD72\u3001\u77E9\u5F622\xD74\u3001\u77E9\u5F622\xD74\u3001\u5186\u5F62 \u534A\u5F841.2\u3001\u5186\u5F62 \u534A\u5F841.2)\n\u76E4\u9762\u306E\u7A4D\u307F\u6728\u306E\u4E0A\u9650: 24\u500B"
