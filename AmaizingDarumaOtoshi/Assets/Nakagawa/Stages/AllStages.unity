  m_layout: "\u5E83\u3055: 20\xD720m\n\u30AE\u30DF\u30C3\u30AF: \u30D0\u30F3\u30D1\u30FC\xD74\u3001\u56DE\u8EE2\u53F0\xD71\n\u751F\u6210\u30A8\u30EA\u30A2: 7\u304B\u6240(\u5186\u5F62 \u534A\u5F842\u3001\u77E9\u5F628\xD73\u3001\u77E9\u5F628\xD73\u3001\u77E9\u5F623\xD78\u3001\u77E9\u5F623\xD78\u3001\u5186\u5F62 \u534A\u5F841\u3001\u5186\u5F62 \u534A\u5F841)\n\u76E4\u9762\u306E\u7A4D\u307F\u6728\u306E\u4E0A\u9650: 22\u500B"
