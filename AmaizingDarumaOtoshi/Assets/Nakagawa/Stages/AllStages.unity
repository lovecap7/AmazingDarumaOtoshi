  m_title: "\u6D41\u7802\u3068\u4ED5\u639B\u3051\u58C1"
  m_concept: "\u3042\u3061\u3053\u3061\u306B\u6D41\u7802(\u6E1B\u901F\u5E8A)\u304C\u5E83\u304C\u308B\u907A\u8DE1\u3002\u4E2D\u592E\u306E\u77F3\u67F1\u3068\u3001\u5317\u897F\u30FB\u5357\u6771\u306E\u4ED5\u639B\u3051\u58C1\u304C\u6642\u9593\u5DEE\u3067\u305B\u308A\u4E0A\u304C\u308B\u3002"
  m_expectedFlow: "\u6D41\u7802\u306B\u8DB3\u3092\u53D6\u3089\u308C\u308B\u3068\u52D5\u304D\u304C\u920D\u308A\u3001\u4ED5\u639B\u3051\u58C1\u306E\u9670\u306B\u9003\u3052\u8FBC\u3080\u306E\u304C\u9045\u308C\u308B\u3002\u4E2D\u592E\u306E\u77F3\u67F1\u304C\u4E0A\u304C\u308B\u3068\u5357\u5317\u306E\u88DC\u7D66\u6240\u306E\u9593\u306E\u5C04\u7DDA\u304C\u3055\u3048\u304E\u3089\u308C\u308B\u3002\u6D41\u7802\u3092\u907F\u3051\u3066\u56DE\u308A\u8FBC\u3080\u304B\u3001\u9045\u304F\u306A\u308B\u306E\u3092\u627F\u77E5\u3067\u7A81\u3063\u5207\u308B\u304B\u3002"
  m_layout: "\u5E83\u3055: 30\xD726m\n\u30AE\u30DF\u30C3\u30AF: \u305B\u308A\u4E0A\u304C\u308A\u5840\xD73\u3001\u6E1B\u901F\u5E8A\xD74\n\u751F\u6210\u30A8\u30EA\u30A2: 6\u304B\u6240(\u5186\u5F62 \u534A\u5F841.2\u3001\u5186\u5F62 \u534A\u5F841.2\u3001\u5186\u5F62 \u534A\u5F841.5\u3001\u5186\u5F62 \u534A\u5F841.5\u3001\u77E9\u5F623\xD74\u3001\u77E9\u5F623\xD74)\n\u76E4\u9762\u306E\u7A4D\u307F\u6728\u306E\u4E0A\u9650: 24\u500B"
