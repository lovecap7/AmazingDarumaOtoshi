  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Nakagawa.StageInfo
  m_id: Stage07
  m_title: "\u96FB\u5B50\u30EC\u30F3\u30B8\u306E\u56DE\u8EE2\u76BF"
  m_concept: "\u56DB\u65B9\u3092\u58C1\u306B\u56F2\u307E\u308C\u305F\u96FB\u5B50\u30EC\u30F3\u30B8\u306E\u4E2D\u3002\u5E8A\u306E\u5927\u534A\u3092\u5927\u304D\u306A\u56DE\u8EE2\u76BF\u304C\u5360\u3081\u3001\u3086\u3063\u304F\u308A\u9006\u56DE\u308A\u306B\u56DE\u308A\u7D9A\u3051\u308B\u3002"
  m_expectedFlow: "\u56DE\u8EE2\u76BF\u306E\u4E0A\u3092\u901A\u308B\u5F3E\u306F\u5927\u304D\u304F\u66F2\u304C\u308A\u3001\u58C1\u3067\u8DF3\u306D\u8FD4\u3063\u3066\u3055\u3089\u306B\u8AAD\u3081\u306A\u3044\u8ECC\u9053\u306B\u306A\u308B\u3002\u51FA\u73FE\u4F4D\u7F6E\u306F\u76BF\u306E\u5916\u306E\u56DB\u9685\u3067\u3001\u76BF\u306B\u4E57\u308B\u3068\u6D41\u3055\u308C\u3066\u4F4D\u7F6E\u304C\u305A\u308C\u308B\u3002\u76BF\u306E\u4E0A\u306E\u88DC\u7D66\u6240\u306B\u6E67\u3044\u305F\u7A4D\u307F\u6728\u306F\u56DE\u308A\u306A\u304C\u3089\u5916\u3078\u904B\u3070\u308C\u308B\u306E\u3067\u3001\u76BF\u306E\u7E01\u3067\u5F85\u3061\u69CB\u3048\u308B\u306E\u3082\u624B\u3002"
  m_layout: "\u5E83\u3055: 24\xD724m\n\u30AE\u30DF\u30C3\u30AF: \u56DE\u8EE2\u53F0\xD71\n\u751F\u6210\u30A8\u30EA\u30A2: 6\u304B\u6240(\u5186\u5F62 \u534A\u5F842.5\u3001\u5186\u5F62 \u534A\u5F841.5\u3001\u77E9\u5F626\xD73\u3001\u77E9\u5F626\xD73\u3001\u77E9\u5F623\xD76\u3001\u77E9\u5F623\xD76)\n\u76E4\u9762\u306E\u7A4D\u307F\u6728\u306E\u4E0A\u9650: 20\u500B"
