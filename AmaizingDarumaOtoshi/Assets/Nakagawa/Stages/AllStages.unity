  m_concept: "\u5357\u5074\u304C\u5D16\u306E\u659C\u9762\u3002\u5317\u306E\u6247\u98A8\u6A5F\u304C\u6771\u897F\u306B\u5F80\u5FA9\u3057\u306A\u304C\u3089\u96EA\u5D29\u306E\u3088\u3046\u306A\u98A8\u3092\u5357\u3078\u5439\u304D\u4E0B\u308D\u3059\u3002\u4E2D\u307B\u3069\u306B\u306F\u96EA\u3088\u3051\u306E\u67F5(\u305B\u308A\u4E0A\u304C\u308A\u5840)\u3002"
