  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Nakagawa.StageInfo
  m_id: DebugStage70
  m_title: "\u5B87\u5B99\u30B4\u30DF\u306E\u56DE\u53CE"
  m_concept: "\u4E2D\u592E\u306E\u56DE\u8EE2\u7832\u53F0\u304C\u5B87\u5B99\u30B4\u30DF(\u7A4D\u307F\u6728)\u3092\u307E\u304D\u6563\u3089\u3059\u3002\u56DB\u9685\u306B\u306F\u7A4D\u307F\u6728\u3060\u3051\u3092\u5438\u3044\u8FBC\u3093\u3067\u5225\u306E\u9685\u304B\u3089\u5410\u304D\u51FA\u3059\u56DE\u53CE\u30B2\u30FC\u30C8(\u30EF\u30FC\u30D7\u30B2\u30FC\u30C8)\u3002"
  m_expectedFlow: "\u7832\u53F0\u304B\u3089\u307E\u304B\u308C\u305F\u7A4D\u307F\u6728\u304C\u56DB\u9685\u3078\u6D41\u308C\u308B\u3068\u3001\u56DE\u53CE\u30B2\u30FC\u30C8\u306B\u5438\u3044\u8FBC\u307E\u308C\u3066\u5225\u306E\u9685\u304B\u3089\u98DB\u3073\u51FA\u3059\u3002\u30B2\u30FC\u30C8\u306E\u524D\u306B\u7ACB\u3064\u3068\u3001\u3069\u3053\u304B\u3089\u98DB\u3093\u3067\u304D\u305F\u304B\u5206\u304B\u3089\u306A\u3044\u5F3E\u306B\u5F53\u305F\u308B\u3002\u81EA\u5206\u3067\u6BB4\u3063\u305F\u7A4D\u307F\u6728\u3092\u30B2\u30FC\u30C8\u306B\u6253\u3061\u8FBC\u3081\u3070\u3001\u96E2\u308C\u305F\u9685\u306E\u76F8\u624B\u3092\u72D9\u3048\u308B\u3002"
  m_layout: "\u5E83\u3055: 30\xD726m\n\u30AE\u30DF\u30C3\u30AF: \u30EF\u30FC\u30D7\u30B2\u30FC\u30C8\xD74\u3001\u56DE\u8EE2\u7832\u53F0\xD71\n\u751F\u6210\u30A8\u30EA\u30A2: 6\u304B\u6240(\u5186\u5F62 \u534A\u5F841.5\u3001\u5186\u5F62 \u534A\u5F841.5\u3001\u77E9\u5F628\xD73\u3001\u77E9\u5F628\xD73\u3001\u77E9\u5F623\xD76\u3001\u77E9\u5F623\xD76)\n\u76E4\u9762\u306E\u7A4D\u307F\u6728\u306E\u4E0A\u9650: 24\u500B"
