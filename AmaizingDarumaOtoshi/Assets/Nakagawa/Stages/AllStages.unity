  m_EditorClassIdentifier: Assembly-CSharp::Nakagawa.StageInfo
  m_id: DebugStage32
  m_title: "\u30ED\u30C3\u30AB\u30FC\u306E\u8FF7\u8DEF"
  m_concept: "\u98A8\u8ECA\u306E\u7FBD\u306E\u3088\u3046\u306B\u56DB\u679A\u306E\u30ED\u30C3\u30AB\u30FC(\u58C1)\u304C\u4E2D\u592E\u3092\u56F2\u3080\u90E8\u5BA4\u3002\u5317\u306E\u901A\u8DEF\u306B\u306F\u5317\u897F\u306E\u6247\u98A8\u6A5F\u304C\u6771\u3078\u3001\u5357\u306E\u901A\u8DEF\u306B\u306F\u5357\u6771\u306E\u6247\u98A8\u6A5F\u304C\u897F\u3078\u98A8\u3092\u9001\u308B\u3002"
  m_expectedFlow: "\u30ED\u30C3\u30AB\u30FC\u306E\u5207\u308C\u76EE\u306F\u98A8\u8ECA\u306E\u3088\u3046\u306B\u305A\u308C\u3066\u3044\u308B\u306E\u3067\u3001\u771F\u3093\u4E2D\u3078\u306F\u3069\u306E\u65B9\u5411\u304B\u3089\u3082\u659C\u3081\u306B\u5165\u308B\u3053\u3068\u306B\u306A\u308A\u3001\u8DF3\u5F3E\u3067\u6B7B\u89D2\u304B\u3089\u72D9\u3048\u308B\u3002\u5357\u5317\u306E\u901A\u8DEF\u306F\u98A8\u306B\u4E57\u308B\u3068\u901F\u304F\u8D70\u308C\u3066\u5F3E\u3082\u4F38\u3073\u308B\u304C\u3001\u88DC\u7D66\u6240\u3067\u7ACB\u3061\u6B62\u307E\u308B\u3068\u6D41\u3055\u308C\u308B\u3002\u6771\u897F\u306E\u30D0\u30F3\u30D1\u30FC\u306F\u901A\u8DEF\u306E\u51FA\u53E3\u3067\u5F85\u3064\u76F8\u624B\u3092\u306F\u3058\u304D\u51FA\u3059\u3002"
  m_layout: "\u5E83\u3055: 30\xD722m\n\u30AE\u30DF\u30C3\u30AF: \u6247\u98A8\u6A5F\xD72\u3001\u30D0\u30F3\u30D1\u30FC\xD72\n\u751F\u6210\u30A8\u30EA\u30A2: 7\u304B\u6240(\u5186\u5F62 \u534A\u5F841.8\u3001\u77E9\u5F626\xD72.5\u3001\u77E9\u5F626\xD72.5\u3001\u77E9\u5F622\xD74\u3001\u77E9\u5F622\xD74\u3001\u5186\u5F62 \u534A\u5F841\u3001\u5186\u5F62 \u534A\u5F841)\n\u76E4\u9762\u306E\u7A4D\u307F\u6728\u306E\u4E0A\u9650: 24\u500B"
