  m_title: "\u30B0\u30E9\u30A6\u30F3\u30C9\u306E\u7802\u5D50"
  m_concept: "\u6771\u897F\u304C\u5D16\u306E\u30B0\u30E9\u30A6\u30F3\u30C9\u3002\u5317\u306E\u6247\u98A8\u6A5F\u306F\u6771\u897F\u306B\u5F80\u5FA9\u3057\u306A\u304C\u3089\u5357\u3078\u3001\u5357\u306E\u6247\u98A8\u6A5F\u306F\u9006\u5411\u304D\u306B\u5F80\u5FA9\u3057\u306A\u304C\u3089\u5317\u3078\u7802\u5D50\u3092\u5439\u304D\u3064\u3051\u308B\u3002\u4E2D\u592E\u306B\u5927\u304D\u306A\u30D0\u30F3\u30D1\u30FC\u3002"
  m_expectedFlow: "\u5357\u5317\u306E\u98A8\u306F\u5F80\u5FA9\u306E\u5411\u304D\u304C\u9006\u306A\u306E\u3067\u3001\u98A8\u306E\u5F53\u305F\u308B\u5834\u6240\u304C\u523B\u3005\u3068\u5165\u308C\u66FF\u308F\u308B\u3002\u98A8\u306B\u62BC\u3055\u308C\u306A\u304C\u3089\u4E2D\u592E\u306E\u30D0\u30F3\u30D1\u30FC\u306B\u306F\u3058\u304B\u308C\u308B\u3068\u3001\u6771\u897F\u306E\u5D16\u307E\u3067\u8EE2\u304C\u308B\u3053\u3068\u3082\u3002\u5D16\u969B\u306E\u88DC\u7D66\u6240\u306F\u7A4D\u307F\u6728\u304C\u591A\u3044\u4EE3\u308F\u308A\u306B\u843D\u3061\u3084\u3059\u3044\u3002\u98A8\u306E\u5207\u308C\u76EE\u3092\u8AAD\u3093\u3067\u3001\u5D16\u969B\u306E\u76F8\u624B\u3092\u6483\u3061\u843D\u3068\u3059\u3002"
  m_layout: "\u5E83\u3055: 28\xD724m\n\u30AE\u30DF\u30C3\u30AF: \u6247\u98A8\u6A5F\xD72\u3001\u30D0\u30F3\u30D1\u30FC\xD71\n\u751F\u6210\u30A8\u30EA\u30A2: 6\u304B\u6240(\u77E9\u5F623\xD76\u3001\u77E9\u5F623\xD76\u3001\u5186\u5F62 \u534A\u5F841.2\u3001\u5186\u5F62 \u534A\u5F841.2\u3001\u5186\u5F62 \u534A\u5F841.2\u3001\u5186\u5F62 \u534A\u5F841.2)\n\u76E4\u9762\u306E\u7A4D\u307F\u6728\u306E\u4E0A\u9650: 24\u500B"
