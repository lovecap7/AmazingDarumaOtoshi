  m_title: "\u96D1\u5DFE\u304C\u3051\u306E\u5ECA\u4E0B"
  m_concept: "\u6771\u897F\u306E\u7AEF\u304C\u958B\u3044\u305F\u9577\u3044\u5ECA\u4E0B\u3002\u96D1\u5DFE\u304C\u3051\u3067\u3064\u308B\u3064\u308B\u306B\u306A\u3063\u305F\u5E8A(\u52A0\u901F\u5E8A)\u304C\u6771\u897F\u306B\u4F38\u3073\u3001\u7AEF\u306E\u624B\u524D\u306B\u30EF\u30C3\u30AF\u30B9\u306E\u4E7E\u3044\u3066\u3044\u306A\u3044\u6E1B\u901F\u5E8A\u3002"
  m_expectedFlow: "\u52A0\u901F\u5E8A\u306B\u4E57\u308B\u3068\u4F53\u3082\u5F3E\u3082\u4E00\u6C17\u306B\u6ED1\u308A\u3001\u305D\u306E\u307E\u307E\u5ECA\u4E0B\u306E\u7AEF\u304B\u3089\u98DB\u3073\u51FA\u3057\u304B\u306D\u306A\u3044\u3002\u7AEF\u306E\u624B\u524D\u306E\u6E1B\u901F\u5E8A\u304C\u6700\u5F8C\u306E\u30D6\u30EC\u30FC\u30AD\u3002\u52A0\u901F\u5E8A\u306E\u4E0A\u306E\u7A4D\u307F\u6728\u306F\u8D70\u308A\u51FA\u3059\u306E\u3067\u3001\u62FE\u3044\u306B\u884C\u304F\u3088\u308A\u6D41\u308C\u3066\u304F\u308B\u306E\u3092\u5F85\u3064\u306E\u3082\u624B\u3002\u5ECA\u4E0B\u306E\u7AEF\u306E\u88DC\u7D66\u6240\u306F\u3001\u6ED1\u3063\u3066\u304D\u305F\u76F8\u624B\u306B\u62BC\u3057\u51FA\u3055\u308C\u308B\u5371\u967A\u5730\u5E2F\u3002"
