  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Nakagawa.StageInfo
  m_id: DebugStage38
  m_title: "\u969C\u5BB3\u7269\u8D70"
  m_concept: "\u6771\u897F\u306B\u9577\u3044\u30B3\u30FC\u30B9\u3002\u4E2D\u592E\u306E\u5E2F\u306B5\u672C\u306E\u30CF\u30FC\u30C9\u30EB(\u305B\u308A\u4E0A\u304C\u308A\u5840)\u304C\u4E26\u3073\u3001\u897F\u304B\u3089\u9806\u306B\u7ACB\u3061\u4E0A\u304C\u308B\u3002\u5357\u5317\u306E\u901A\u8DEF\u306E\u3042\u3061\u3053\u3061\u306B\u306C\u304B\u308B\u307F(\u6E1B\u901F\u5E8A)\u3002"
  m_expectedFlow: "\u30CF\u30FC\u30C9\u30EB\u306F\u8DF3\u3093\u3067\u3082\u8D8A\u3048\u3089\u308C\u306A\u3044\u9AD8\u3055\u306A\u306E\u3067\u3001\u7ACB\u3063\u3066\u3044\u308B\u9593\u306F\u4E2D\u592E\u306E\u5E2F\u304C\u5C0F\u90E8\u5C4B\u306B\u533A\u5207\u3089\u308C\u308B\u3002\u30CF\u30FC\u30C9\u30EB\u306E\u9593\u306E\u88DC\u7D66\u6240\u306F\u3001\u4E21\u96A3\u304C\u4E0B\u304C\u3063\u3066\u3044\u308B\u9593\u3060\u3051\u51FA\u5165\u308A\u3067\u304D\u308B\u3002\u5357\u5317\u306E\u901A\u8DEF\u306F\u56DE\u308A\u9053\u3060\u304C\u3001\u306C\u304B\u308B\u307F\u306B\u8DB3\u3092\u53D6\u3089\u308C\u308B\u3068\u72D9\u3044\u6483\u3061\u3055\u308C\u308B\u3002\u30CF\u30FC\u30C9\u30EB\u304C\u4E0A\u304C\u308B\u77AC\u9593\u306B\u4E57\u3063\u3066\u3044\u308C\u3070\u3001\u9AD8\u53F0\u304B\u3089\u6483\u3061\u4E0B\u308D\u305B\u308B\u3002"
  m_layout: "\u5E83\u3055: 34\xD720m\n\u30AE\u30DF\u30C3\u30AF: \u305B\u308A\u4E0A\u304C\u308A\u5840\xD75\u3001\u6E1B\u901F\u5E8A\xD74\n\u751F\u6210\u30A8\u30EA\u30A2: 6\u304B\u6240(\u5186\u5F62 \u534A\u5F841.3\u3001\u5186\u5F62 \u534A\u5F841.3\u3001\u5186\u5F62 \u534A\u5F841.3\u3001\u5186\u5F62 \u534A\u5F841.3\u3001\u77E9\u5F623\xD74\u3001\u77E9\u5F623\xD74)\n\u76E4\u9762\u306E\u7A4D\u307F\u6728\u306E\u4E0A\u9650: 24\u500B"
