  m_id: DebugStage40
  m_title: "\u30EA\u30EC\u30FC\u306E\u30D0\u30C8\u30F3\u30BE\u30FC\u30F3"
  m_concept: "\u4E2D\u592E\u306E\u4ED5\u5207\u308A\u3067\u5357\u5317\u306E\u30EC\u30FC\u30F3\u306B\u5206\u304B\u308C\u305F\u30B3\u30FC\u30B9\u3002\u4ED5\u5207\u308A\u306F\u771F\u3093\u4E2D\u3068\u4E21\u7AEF\u304C\u5207\u308C\u3066\u3044\u308B\u3002\u56DB\u9685\u306E\u30B7\u30E5\u30FC\u30BF\u30FC\u30EC\u30FC\u30F3\u304C\u7A4D\u307F\u6728\u3092\u9685\u304B\u3089\u9685\u3078\u30EA\u30EC\u30FC\u3057\u3001\u4ED5\u5207\u308A\u306E\u5207\u308C\u76EE\u306E\u5357\u5317\u306B\u30D0\u30F3\u30D1\u30FC\u3002"
  m_expectedFlow: "\u30EC\u30FC\u30F3\u306B\u4E57\u3063\u305F\u7A4D\u307F\u6728\u306F\u30D0\u30C8\u30F3\u306E\u3088\u3046\u306B\u9685\u304B\u3089\u9685\u3078\u53D7\u3051\u6E21\u3055\u308C\u3001\u30EC\u30FC\u30F3\u306E\u4E0A\u3092\u4E00\u76F4\u7DDA\u306B\u8D70\u308B\u3002\u4ED5\u5207\u308A\u306E\u771F\u3093\u4E2D\u306E\u5207\u308C\u76EE\u306F\u5357\u5317\u3092\u884C\u304D\u6765\u3059\u308B\u8FD1\u9053\u3060\u304C\u3001\u4E21\u5074\u306E\u30D0\u30F3\u30D1\u30FC\u306B\u306F\u3058\u304B\u308C\u3084\u3059\u3044\u3002\u81EA\u5206\u3067\u6BB4\u3063\u305F\u7A4D\u307F\u6728\u3092\u30EA\u30EC\u30FC\u306B\u4E57\u305B\u308C\u3070\u3001\u9060\u304F\u306E\u76F8\u624B\u3092\u72D9\u3048\u308B\u3002"
  m_layout: "\u5E83\u3055: 32\xD720m\n\u30AE\u30DF\u30C3\u30AF: \u30D0\u30F3\u30D1\u30FC\xD72\u3001\u30B7\u30E5\u30FC\u30BF\u30FC\u30EC\u30FC\u30F3\xD74\n\u751F\u6210\u30A8\u30EA\u30A2: 6\u304B\u6240(\u5186\u5F62 \u534A\u5F841.5\u3001\u5186\u5F62 \u534A\u5F841.5\u3001\u77E9\u5F626\xD72\u3001\u77E9\u5F626\xD72\u3001\u77E9\u5F622\xD72.5\u3001\u77E9\u5F622\xD72.5)\n\u76E4\u9762\u306E\u7A4D\u307F\u6728\u306E\u4E0A\u9650: 24\u500B"
