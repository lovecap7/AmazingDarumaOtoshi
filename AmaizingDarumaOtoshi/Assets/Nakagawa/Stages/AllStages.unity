  m_id: DebugStage27
  m_title: "\u6C37\u3068\u6CE5\u306E\u5EAD"
  m_concept: "\u52A0\u901F\u5E8A\u3068\u6E1B\u901F\u5E8A\u304C\u5E02\u677E\u6A21\u69D8\u306B\u4E26\u3076\u5EAD\u3002\u4E2D\u592E\u306B\u5927\u304D\u306A\u30D0\u30F3\u30D1\u30FC\u3001\u56DB\u9685\u306B\u5C0F\u3055\u306A\u30D0\u30F3\u30D1\u30FC\u3002"
  m_expectedFlow: "\u52A0\u901F\u5E8A(\u30AA\u30EC\u30F3\u30B8)\u3092\u8E0F\u3080\u3068\u4F53\u3082\u5F3E\u3082\u4E00\u6C17\u306B\u901F\u304F\u306A\u308A\u3001\u6E1B\u901F\u5E8A(\u9752\u7DD1)\u3067\u306F\u6CE5\u306B\u306F\u307E\u3063\u305F\u3088\u3046\u306B\u9045\u304F\u306A\u308B\u3002\u6B62\u307E\u3063\u3066\u3044\u308B\u7A4D\u307F\u6728\u3082\u52A0\u901F\u5E8A\u306E\u4E0A\u3067\u306F\u5411\u3044\u3066\u3044\u308B\u65B9\u5411\u3078\u8D70\u308A\u51FA\u3059\u306E\u3067\u3001\u5E8A\u306E\u8272\u3092\u898B\u3066\u7A4D\u307F\u6728\u306E\u884C\u304D\u5148\u3092\u8AAD\u3080\u5FC5\u8981\u304C\u3042\u308B\u3002\u4E2D\u592E\u306E\u30D0\u30F3\u30D1\u30FC\u306B\u306F\u3058\u304B\u308C\u3066\u52A0\u901F\u5E8A\u3078\u98DB\u3073\u8FBC\u3080\u3068\u3001\u305D\u306E\u307E\u307E\u58C1\u307E\u3067\u6ED1\u3063\u3066\u3044\u304F\u3002"
  m_layout: "\u5E83\u3055: 30\xD730m\n\u30AE\u30DF\u30C3\u30AF: \u30D0\u30F3\u30D1\u30FC\xD75\u3001\u52A0\u901F\u5E8A\xD74\u3001\u6E1B\u901F\u5E8A\xD74\n\u751F\u6210\u30A8\u30EA\u30A2: 6\u304B\u6240(\u5186\u5F62 \u534A\u5F841.5\u3001\u5186\u5F62 \u534A\u5F841.5\u3001\u5186\u5F62 \u534A\u5F841.5\u3001\u5186\u5F62 \u534A\u5F841.5\u3001\u77E9\u5F626\xD72\u3001\u77E9\u5F626\xD72)\n\u76E4\u9762\u306E\u7A4D\u307F\u6728\u306E\u4E0A\u9650: 26\u500B"
