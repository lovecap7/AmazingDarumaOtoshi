  m_id: DebugStage46
  m_title: "\u30BB\u30F3\u30BF\u30FC\u30B5\u30FC\u30AF\u30EB"
  m_concept: "\u6771\u897F\u306B\u9577\u3044\u30D4\u30C3\u30C1\u3002\u6771\u897F\u306E\u58C1\u306E\u771F\u3093\u4E2D\u304C\u30B4\u30FC\u30EB\u306E\u53E3\u306B\u306A\u3063\u3066\u3044\u3066\u3001\u305D\u3053\u3060\u3051\u5916\u3078\u843D\u3061\u308B\u3002\u4E2D\u592E\u306B\u30BB\u30F3\u30BF\u30FC\u30B5\u30FC\u30AF\u30EB\u306E\u56DE\u8EE2\u53F0\u3001\u30B4\u30FC\u30EB\u524D\u306B\u30AD\u30FC\u30D1\u30FC\u306E\u30D0\u30F3\u30D1\u30FC\u3002"
  m_expectedFlow: "\u76F8\u624B\u3092\u30B4\u30FC\u30EB\u306E\u53E3\u3078\u6483\u3061\u8FBC\u3081\u3070\u3001\u305D\u306E\u307E\u307E\u5834\u5916\u3078\u843D\u3068\u305B\u308B\u3002\u30B4\u30FC\u30EB\u524D\u306E\u30AD\u30FC\u30D1\u30FC(\u30D0\u30F3\u30D1\u30FC)\u304C\u5F3E\u3082\u4F53\u3082\u306F\u3058\u304F\u306E\u3067\u3001\u6B63\u9762\u304B\u3089\u306F\u6C7A\u307E\u308A\u306B\u304F\u304F\u3001\u56DE\u8EE2\u53F0\u3067\u66F2\u3052\u305F\u5F3E\u3084\u8DF3\u5F3E\u3067\u89D2\u5EA6\u3092\u3064\u3051\u3066\u72D9\u3046\u3002\u30B4\u30FC\u30EB\u8107\u306E\u88DC\u7D66\u6240\u306F\u7A4D\u307F\u6728\u304C\u591A\u3044\u304C\u3001\u30AD\u30FC\u30D1\u30FC\u306B\u306F\u3058\u304B\u308C\u3066\u30B4\u30FC\u30EB\u3078\u8EE2\u304C\u308B\u5371\u967A\u304C\u3042\u308B\u3002"
  m_layout: "\u5E83\u3055: 32\xD722m\n\u30AE\u30DF\u30C3\u30AF: \u30D0\u30F3\u30D1\u30FC\xD72\u3001\u56DE\u8EE2\u53F0\xD71\n\u751F\u6210\u30A8\u30EA\u30A2: 7\u304B\u6240(\u5186\u5F62 \u534A\u5F842.5\u3001\u5186\u5F62 \u534A\u5F841\u3001\u5186\u5F62 \u534A\u5F841\u3001\u5186\u5F62 \u534A\u5F841.2\u3001\u5186\u5F62 \u534A\u5F841.2\u3001\u77E9\u5F628\xD72\u3001\u77E9\u5F628\xD72)\n\u76E4\u9762\u306E\u7A4D\u307F\u6728\u306E\u4E0A\u9650: 24\u500B"
