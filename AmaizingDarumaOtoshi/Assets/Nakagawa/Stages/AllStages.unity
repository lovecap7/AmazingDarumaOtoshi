  m_concept: "\u58C1\u306E\u306A\u3044\u98A8\u5442\u3044\u3059\u306E\u4E0A\u3002\u5317\u897F\u3068\u5357\u6771\u306E\u9685\u306E\u6247\u98A8\u6A5F\u304C\u7E01\u306B\u6CBF\u3063\u3066\u9006\u5411\u304D\u306B\u98A8\u3092\u9001\u308A\u3001\u5916\u5468\u306B\u3064\u3080\u3058\u98A8\u304C\u3067\u304D\u308B\u3002"
