  m_EditorClassIdentifier: Assembly-CSharp::Nakagawa.StageInfo
  m_id: DebugStage31
  m_title: "\u9577\u673A\u306E\u4F1A\u8B70"
  m_concept: "\u90E8\u5BA4\u306E\u9577\u673A\u304C\u4E8C\u672C\u3001\u6771\u897F\u306B\u4E26\u3076\u3002\u673A\u306E\u9593\u306F\u3001\u4E21\u7AEF\u306E\u4ED5\u5207\u308A(\u305B\u308A\u4E0A\u304C\u308A\u5840)\u304C\u9589\u3058\u308B\u3068\u4F1A\u8B70\u5BA4\u306B\u306A\u308B\u3002\u6771\u897F\u306E\u7AEF\u306B\u30DC\u30FC\u30EB\u306E\u3088\u3046\u306A\u30D0\u30F3\u30D1\u30FC\u3002"
  m_expectedFlow: "\u4E21\u7AEF\u306E\u4ED5\u5207\u308A\u306F\u6642\u9593\u3092\u305A\u3089\u3057\u3066\u9589\u3058\u308B\u306E\u3067\u3001\u4F1A\u8B70\u5BA4\u306F\u3044\u3064\u3082\u3069\u3061\u3089\u304B\u4E00\u65B9\u304B\u3089\u3060\u3051\u5165\u308C\u308B\u3002\u4E2D\u306E\u88DC\u7D66\u6240\u306F\u5B88\u308A\u3084\u3059\u3044\u304C\u3001\u958B\u3044\u3066\u3044\u308B\u5074\u304B\u3089\u6483\u3061\u8FBC\u307E\u308C\u308B\u3002\u4ED5\u5207\u308A\u304C\u4E0A\u304C\u308B\u77AC\u9593\u306B\u4E2D\u306B\u3044\u308C\u3070\u9589\u3058\u3053\u3082\u308C\u3001\u4E57\u3063\u3066\u3044\u308C\u3070\u673A\u3088\u308A\u9AD8\u3044\u6240\u304B\u3089\u6483\u3061\u4E0B\u308D\u305B\u308B\u3002\u6771\u897F\u306E\u30D0\u30F3\u30D1\u30FC\u306F\u3001\u5916\u3092\u56DE\u308B\u76F8\u624B\u3092\u4F1A\u8B70\u5BA4\u306E\u5165\u53E3\u3078\u306F\u3058\u304D\u8FD4\u3059\u3002"
  m_layout: "\u5E83\u3055: 28\xD722m\n\u30AE\u30DF\u30C3\u30AF: \u30D0\u30F3\u30D1\u30FC\xD72\u3001\u305B\u308A\u4E0A\u304C\u308A\u5840\xD72\n\u751F\u6210\u30A8\u30EA\u30A2: 7\u304B\u6240(\u5186\u5F62 \u534A\u5F842.2\u3001\u77E9\u5F628\xD73\u3001\u77E9\u5F628\xD73\u3001\u5186\u5F62 \u534A\u5F841.2\u3001\u5186\u5F62 \u534A\u5F841.2\u3001\u5186\u5F62 \u534A\u5F841.2\u3001\u5186\u5F62 \u534A\u5F841.2)\n\u76E4\u9762\u306E\u7A4D\u307F\u6728\u306E\u4E0A\u9650: 24\u500B"
