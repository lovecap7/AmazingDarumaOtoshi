  m_layout: "\u5E83\u3055: 32\xD722m\n\u30AE\u30DF\u30C3\u30AF: \u6247\u98A8\u6A5F\xD72\u3001\u305B\u308A\u4E0A\u304C\u308A\u5840\xD710\n\u751F\u6210\u30A8\u30EA\u30A2: 6\u304B\u6240(\u5186\u5F62 \u534A\u5F841.5\u3001\u5186\u5F62 \u534A\u5F841.5\u3001\u5186\u5F62 \u534A\u5F841.5\u3001\u5186\u5F62 \u534A\u5F841.5\u3001\u77E9\u5F624\xD72\u3001\u77E9\u5F624\xD72)\n\u76E4\u9762\u306E\u7A4D\u307F\u6728\u306E\u4E0A\u9650: 24\u500B"
