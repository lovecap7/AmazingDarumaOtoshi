  m_expectedFlow: "\u56DE\u5ECA\u306F\u4E00\u5468\u3067\u304D\u308B\u306E\u3067\u3001\u8FFD\u3044\u304B\u3051\u3063\u3053\u3068\u56DE\u308A\u8FBC\u307F\u304C\u8D77\u304D\u3084\u3059\u3044\u3002\u5185\u5074\u306E\u7E01\u3067\u5F3E\u3092\u907F\u3051\u308B\u3068\u7A74\u3078\u843D\u3061\u308B\u5371\u967A\u304C\u3042\u308A\u3001\u30D0\u30F3\u30D1\u30FC\u306B\u306F\u3058\u304B\u308C\u308B\u5834\u6240\u3067\u306F\u7279\u306B\u6CE8\u610F\u304C\u5FC5\u8981\u3002\u88DC\u7D66\u6240\u306F\u5404\u8FBA\u306E\u4E2D\u592E\u306B\u3042\u308A\u3001\u89D2\u3092\u66F2\u304C\u3063\u305F\u5148\u3067\u9262\u5408\u308F\u305B\u308B\u906D\u9047\u6226\u304C\u591A\u3044\u3002"
  m_layout: "\u5E83\u3055: 32\xD732m\n\u30AE\u30DF\u30C3\u30AF: \u30D0\u30F3\u30D1\u30FC\xD74\n\u751F\u6210\u30A8\u30EA\u30A2: 8\u304B\u6240(\u77E9\u5F628\xD74\u3001\u77E9\u5F628\xD74\u3001\u77E9\u5F624\xD78\u3001\u77E9\u5F624\xD78\u3001\u5186\u5F62 \u534A\u5F842\u3001\u5186\u5F62 \u534A\u5F842\u3001\u5186\u5F62 \u534A\u5F842\u3001\u5186\u5F62 \u534A\u5F842)\n\u76E4\u9762\u306E\u7A4D\u307F\u6728\u306E\u4E0A\u9650: 26\u500B"
