  m_concept: "\u5948\u843D\u306B\u6D6E\u304B\u3076\u56DB\u3064\u306E\u5CF6\u3002\u6A4B\u306F\u306A\u304F\u3001\u5CF6\u306E\u9593\u306F\u30EF\u30FC\u30D7\u30B2\u30FC\u30C8\u3067\u3057\u304B\u884C\u304D\u6765\u3067\u304D\u306A\u3044\u3002\u5404\u5CF6\u306E\u4E2D\u592E\u306B\u30D0\u30F3\u30D1\u30FC\u3002"
