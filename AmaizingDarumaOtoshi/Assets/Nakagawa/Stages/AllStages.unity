  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Nakagawa.StageInfo
  m_id: DebugStage28
  m_title: "\u6D41\u308C\u308B\u8DB3\u5834\u306E\u5DE5\u5834"
  m_concept: "\u4E2D\u592E\u306B\u56DB\u89D2\u3044\u5927\u7A74\u304C\u7A7A\u3044\u305F\u5DE5\u5834\u3002\u7A74\u306E\u4E2D\u3092\u4E8C\u679A\u306E\u30D1\u30EC\u30C3\u30C8\u304C\u540C\u3058\u5411\u304D\u306B\u5468\u56DE\u3057\u3001\u5916\u5468\u306E\u56DB\u9685\u306E\u30B7\u30E5\u30FC\u30BF\u30FC\u30EC\u30FC\u30F3\u304C\u58C1\u6CBF\u3044\u306B\u6642\u8A08\u56DE\u308A\u306B\u7A4D\u307F\u6728\u3092\u9001\u308B\u3002"
  m_expectedFlow: "\u5916\u5468\u306E\u7A4D\u307F\u6728\u306F\u30EC\u30FC\u30F3\u304B\u3089\u30EC\u30FC\u30F3\u3078\u3068\u6642\u8A08\u56DE\u308A\u306B\u904B\u3070\u308C\u7D9A\u3051\u3001\u30EC\u30FC\u30F3\u306E\u5148\u306B\u7ACB\u3064\u76F8\u624B\u3092\u8972\u3046\u3002\u7A74\u3092\u7A81\u3063\u5207\u308B\u306B\u306F\u30D1\u30EC\u30C3\u30C8\u306B\u4E57\u308B\u3057\u304B\u306A\u304F\u3001\u5468\u56DE\u306E\u30BF\u30A4\u30DF\u30F3\u30B0\u3092\u5916\u3059\u3068\u5948\u843D\u3078\u843D\u3061\u308B\u3002\u30D1\u30EC\u30C3\u30C8\u306E\u4E0A\u304B\u3089\u5916\u5468\u306E\u76F8\u624B\u3092\u6483\u3064\u304B\u3001\u5916\u5468\u3092\u56DE\u3063\u3066\u7A4D\u307F\u6728\u3092\u96C6\u3081\u308B\u304B\u306E\u9078\u629E\u306B\u306A\u308B\u3002"
  m_layout: "\u5E83\u3055: 34\xD734m\n\u30AE\u30DF\u30C3\u30AF: \u79FB\u52D5\u5E8A\xD72\u3001\u30B7\u30E5\u30FC\u30BF\u30FC\u30EC\u30FC\u30F3\xD74\n\u751F\u6210\u30A8\u30EA\u30A2: 6\u304B\u6240(\u77E9\u5F628\xD73\u3001\u77E9\u5F628\xD73\u3001\u77E9\u5F623\xD78\u3001\u77E9\u5F623\xD78\u3001\u5186\u5F62 \u534A\u5F841.5\u3001\u5186\u5F62 \u534A\u5F841.5)\n\u76E4\u9762\u306E\u7A4D\u307F\u6728\u306E\u4E0A\u9650: 26\u500B"
