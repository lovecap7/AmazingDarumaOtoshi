  m_title: "\u6D17\u3044\u5834\u306E\u6E26"
  m_concept: "\u5357\u5074\u3060\u3051\u58C1\u306E\u306A\u3044\u6D17\u3044\u5834\u3002\u5357\u5BC4\u308A\u306E\u6392\u6C34\u53E3\u306E\u6E26(\u9AD8\u901F\u306E\u56DE\u8EE2\u53F0)\u304C\u3001\u8FD1\u3065\u3044\u305F\u7269\u3092\u5DFB\u304D\u8FBC\u3093\u3067\u6D41\u3059\u3002"
  m_expectedFlow: "\u6392\u6C34\u53E3\u306E\u6E26\u306F\u5357\u306E\u5D16\u306E\u3059\u3050\u305D\u3070\u306B\u3042\u308A\u3001\u4E57\u308B\u3068\u6D41\u3055\u308C\u3066\u5D16\u3078\u904B\u3070\u308C\u3084\u3059\u3044\u3002\u6E26\u306E\u4E0A\u306E\u88DC\u7D66\u6240\u306F\u5371\u967A\u3060\u304C\u7A4D\u307F\u6728\u304C\u591A\u304F\u6E67\u304F\u3002\u5317\u306E\u58C1\u969B\u306F\u5B89\u5168\u306A\u6483\u3061\u5408\u3044\u306E\u5834\u3002\u30D0\u30F3\u30D1\u30FC\u306B\u306F\u3058\u304B\u308C\u3066\u6E26\u306B\u5165\u308B\u3068\u3001\u305D\u306E\u307E\u307E\u5D16\u3078\u4E00\u76F4\u7DDA\u3002"
  m_layout: "\u5E83\u3055: 30\xD723m\n\u30AE\u30DF\u30C3\u30AF: \u30D0\u30F3\u30D1\u30FC\xD72\u3001\u56DE\u8EE2\u53F0\xD71\n\u751F\u6210\u30A8\u30EA\u30A2: 6\u304B\u6240(\u5186\u5F62 \u534A\u5F842\u3001\u77E9\u5F628\xD73\u3001\u77E9\u5F628\xD73\u3001\u77E9\u5F623\xD76\u3001\u77E9\u5F623\xD76\u3001\u5186\u5F62 \u534A\u5F841.6)\n\u76E4\u9762\u306E\u7A4D\u307F\u6728\u306E\u4E0A\u9650: 24\u500B"
