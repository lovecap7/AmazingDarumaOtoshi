  m_concept: "\u5341\u5B57\u5F62\u306E\u901A\u8DEF\u3060\u3051\u306E\u30B9\u30C6\u30FC\u30B8\u3002\u901A\u8DEF\u306E\u6A2A\u306F\u5948\u843D\u3001\u4EA4\u5DEE\u70B9\u306B\u306F\u30D0\u30F3\u30D1\u30FC\u3002\u88DC\u7D66\u6240\u306F\u5404\u901A\u8DEF\u306E\u884C\u304D\u6B62\u307E\u308A\u3002"
