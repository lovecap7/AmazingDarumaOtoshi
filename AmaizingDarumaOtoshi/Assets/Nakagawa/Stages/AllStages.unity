  m_Script: {fileID: 11500000, guid: 2e7d0403be9a2b0418d7666136698b95, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Nakagawa.StageInfo
  m_id: GimmickDebugStage01
  m_title: "\u8FFD\u52A0\u30AE\u30DF\u30C3\u30AF\u30C6\u30B9\u30C8"
  m_concept: "\u8FFD\u52A0\u30AE\u30DF\u30C3\u30AF6\u7A2E(\u305B\u308A\u4E0A\u304C\u308A\u5840\u30FB\u52A0\u901F\u5E8A/\u6E1B\u901F\u5E8A\u30FB\u79FB\u52D5\u5E8A\u30FB\u30EF\u30FC\u30D7\u30B2\u30FC\u30C8\u30FB\u30B7\u30E5\u30FC\u30BF\u30FC\u30EC\u30FC\u30F3\u30FB\u56DE\u8EE2\u7832\u53F0)\u30921\u3064\u306E\u95D8\u6280\u5834\u306B\u307E\u3068\u3081\u305F\u78BA\u8A8D\u7528\u30B9\u30C6\u30FC\u30B8\u3002"
  m_expectedFlow: "\u5317\u897F\u306E\u5840\u304C\u6CE2\u306E\u3088\u3046\u306B\u7ACB\u3061\u4E0A\u304C\u3063\u3066\u58C1\u3068\u9AD8\u53F0\u3092\u4F5C\u308A\u3001\u5317\u6771\u306E\u52A0\u901F\u5E8A\u30FB\u6E1B\u901F\u5E8A\u3067\u5F3E\u3068\u4F53\u306E\u901F\u3055\u304C\u5909\u308F\u308B\u3002\u5357\u897F\u306E\u7A74\u306F\u79FB\u52D5\u5E8A\u3067\u3057\u304B\u6E21\u308C\u305A\u3001\u30EF\u30FC\u30D7\u30B2\u30FC\u30C8\u306F\u8272(\u30B0\u30EB\u30FC\u30D7)\u3054\u3068\u306B\u884C\u304D\u5148\u304C\u6C7A\u307E\u3063\u3066\u3044\u308B\u3002\u6771\u306E\u30B7\u30E5\u30FC\u30BF\u30FC\u30EC\u30FC\u30F3\u306F\u4E57\u3063\u305F\u7A4D\u307F\u6728\u3092\u4E00\u76F4\u7DDA\u306B\u6483\u3061\u51FA\u3057\u3001\u4E2D\u592E\u5357\u306E\u56DE\u8EE2\u7832\u53F0\u306F\u751F\u6210\u547D\u4EE4\u306E\u305F\u3073\u306B\u7A4D\u307F\u6728\u3092\u6247\u72B6\u306B\u3070\u3089\u307E\u304F\u3002"
  m_layout: "\u5E83\u3055: 38\xD734m\n\u30AE\u30DF\u30C3\u30AF: \u305B\u308A\u4E0A\u304C\u308A\u5840\xD75\u3001\u52A0\u901F\u5E8A\xD71\u3001\u6E1B\u901F\u5E8A\xD71\u3001\u79FB\u52D5\u5E8A\xD71\u3001\u30EF\u30FC\u30D7\u30B2\u30FC\u30C8\xD77\u3001\u30B7\u30E5\u30FC\u30BF\u30FC\u30EC\u30FC\u30F3\xD72\u3001\u56DE\u8EE2\u7832\u53F0\xD71\n\u751F\u6210\u30A8\u30EA\u30A2: 6\u304B\u6240(\u5186\u5F62 \u534A\u5F842.5\u3001\u77E9\u5F626\xD73\u3001\u77E9\u5F626\xD72.5\u3001\u5186\u5F62 \u534A\u5F842\u3001\u77E9\u5F626\xD73\u3001\u5186\u5F62 \u534A\u5F841.8)\n\u76E4\u9762\u306E\u7A4D\u307F\u6728\u306E\u4E0A\u9650: 30\u500B"
