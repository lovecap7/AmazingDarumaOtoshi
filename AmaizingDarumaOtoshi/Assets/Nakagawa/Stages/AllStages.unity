  m_title: "\u925B\u7B46\u306E\u4ED5\u5207\u308A"
  m_concept: "\u925B\u7B46\u306E\u4ED5\u5207\u308A(\u58C1)\u3067\u533A\u5207\u3089\u308C\u305F\u7B46\u7BB1\u306E\u4E2D\u3002\u5357\u897F\u306E\u9685\u306E\u5C0F\u578B\u6247\u98A8\u6A5F\u304C\u3001\u5357\u306E\u901A\u8DEF\u3078\u6771\u5411\u304D\u306E\u98A8\u3092\u9001\u308B\u3002"
  m_expectedFlow: "\u4ED5\u5207\u308A\u306B\u6CBF\u3063\u3066\u5F3E\u304C\u8DF3\u306D\u8FD4\u308B\u306E\u3067\u3001\u58C1\u8D8A\u3057\u306E\u8DF3\u5F3E\u3092\u72D9\u3048\u308B\u3002\u5357\u306E\u901A\u8DEF\u306F\u98A8\u306B\u4E57\u3063\u305F\u5F3E\u304C\u901F\u304F\u98DB\u3076\u5371\u967A\u5730\u5E2F\u3002\u4E2D\u592E\u306E\u30D0\u30F3\u30D1\u30FC\u306E\u307E\u308F\u308A\u3068\u3001\u4ED5\u5207\u308A\u306E\u9670\u306E\u88DC\u7D66\u6240\u3092\u884C\u304D\u6765\u3057\u306A\u304C\u3089\u3001\u58C1\u3092\u4F7F\u3063\u3066\u76F8\u624B\u306E\u6B7B\u89D2\u304B\u3089\u6483\u3064\u3002"
  m_layout: "\u5E83\u3055: 30\xD724m\n\u30AE\u30DF\u30C3\u30AF: \u6247\u98A8\u6A5F\xD71\u3001\u30D0\u30F3\u30D1\u30FC\xD71\n\u751F\u6210\u30A8\u30EA\u30A2: 6\u304B\u6240(\u77E9\u5F628\xD73\u3001\u77E9\u5F628\xD73\u3001\u77E9\u5F623\xD76\u3001\u77E9\u5F623\xD76\u3001\u5186\u5F62 \u534A\u5F841.8\u3001\u5186\u5F62 \u534A\u5F841.6)\n\u76E4\u9762\u306E\u7A4D\u307F\u6728\u306E\u4E0A\u9650: 24\u500B"
