  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Nakagawa.StageInfo
  m_id: DebugStage23
  m_title: "\u6E21\u3057\u821F\u306E\u5927\u6CB3"
  m_concept: "\u5357\u5317\u306B\u6D41\u308C\u308B\u5927\u6CB3(\u5948\u843D)\u3067\u6771\u897F\u306E\u5CB8\u304C\u5206\u304B\u308C\u3001\u4E8C\u8258\u306E\u6728\u306E\u30D1\u30EC\u30C3\u30C8\u304C\u5CB8\u306E\u9593\u3092\u5F80\u5FA9\u3059\u308B\u3002\u6CB3\u306E\u4E2D\u592E\u306B\u5C0F\u5CF6\u3002\u4E21\u5CB8\u306E\u6247\u98A8\u6A5F\u304C\u6CB3\u3078\u5411\u3051\u3066\u98A8\u3092\u9001\u308B\u3002"
  m_expectedFlow: "\u5BFE\u5CB8\u3078\u6E21\u308B\u624B\u6BB5\u306F\u30D1\u30EC\u30C3\u30C8\u3060\u3051\u3067\u3001\u4E57\u3063\u3066\u3044\u308B\u9593\u306F\u9003\u3052\u5834\u304C\u306A\u3044\u3002\u5CB8\u306E\u6247\u98A8\u6A5F\u306F\u6CB3\u3078\u5411\u3051\u3066\u5439\u304F\u306E\u3067\u3001\u5CB8\u306E\u7AEF\u3067\u6483\u3061\u5408\u3046\u3068\u98A8\u306B\u62BC\u3055\u308C\u3066\u6CB3\u3078\u843D\u3061\u308B\u3002\u5C0F\u5CF6\u306E\u88DC\u7D66\u6240\u306F\u5371\u967A\u3060\u304C\u7A4D\u307F\u6728\u304C\u6E67\u304D\u3084\u3059\u304F\u3001\u30D1\u30EC\u30C3\u30C8\u306E\u5F80\u5FA9\u306B\u5408\u308F\u305B\u3066\u4E57\u308A\u8FBC\u3080\u30BF\u30A4\u30DF\u30F3\u30B0\u304C\u52DD\u8CA0\u3002"
  m_layout: "\u5E83\u3055: 34\xD726m\n\u30AE\u30DF\u30C3\u30AF: \u6247\u98A8\u6A5F\xD72\u3001\u79FB\u52D5\u5E8A\xD72\n\u751F\u6210\u30A8\u30EA\u30A2: 7\u304B\u6240(\u77E9\u5F626\xD74\u3001\u77E9\u5F626\xD74\u3001\u77E9\u5F626\xD74\u3001\u77E9\u5F626\xD74\u3001\u5186\u5F62 \u534A\u5F841.2\u3001\u5186\u5F62 \u534A\u5F841.5\u3001\u5186\u5F62 \u534A\u5F841.5)\n\u76E4\u9762\u306E\u7A4D\u307F\u6728\u306E\u4E0A\u9650: 24\u500B"
