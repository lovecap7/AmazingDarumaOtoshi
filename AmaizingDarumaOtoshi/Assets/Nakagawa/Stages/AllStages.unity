  m_title: "\u30D7\u30FC\u30EB\u30B5\u30A4\u30C9"
  m_concept: "\u4E2D\u592E\u306B\u30D7\u30FC\u30EB(\u5948\u843D)\u306E\u3042\u308B\u30C7\u30C3\u30AD\u3002\u30D7\u30FC\u30EB\u306E\u4E2D\u3092\u6D6E\u304D\u8F2A\u306E\u30DC\u30FC\u30C8(\u79FB\u52D5\u5E8A)\u304C\u7E01\u306B\u6CBF\u3063\u3066\u5468\u56DE\u3057\u3001\u30D7\u30FC\u30EB\u306E\u89D2\u306B\u6D6E\u304D\u8F2A\u306E\u30D0\u30F3\u30D1\u30FC\u3002"
  m_expectedFlow: "\u30DC\u30FC\u30C8\u306F\u30D7\u30FC\u30EB\u306E\u7E01\u3059\u308C\u3059\u308C\u3092\u56DE\u308B\u306E\u3067\u3001\u8FD1\u3065\u3044\u305F\u6240\u3067\u98DB\u3073\u4E57\u308C\u3070\u8FD1\u9053\u306B\u306A\u308B\u3002\u4E57\u308A\u9045\u308C\u308B\u3068\u30D7\u30FC\u30EB\u3078\u843D\u3061\u308B\u3002\u30D7\u30FC\u30EB\u306E\u7E01\u306E\u88DC\u7D66\u6240\u306F\u3001\u30DC\u30FC\u30C8\u306E\u4E0A\u304B\u3089\u3082\u7E01\u304B\u3089\u3082\u72D9\u308F\u308C\u3001\u89D2\u306E\u30D0\u30F3\u30D1\u30FC\u306B\u306F\u3058\u304B\u308C\u308B\u3068\u30D7\u30FC\u30EB\u3078\u8EE2\u304C\u308A\u8FBC\u3080\u3002\u30C7\u30C3\u30AD\u3092\u5927\u56DE\u308A\u3059\u308B\u304B\u3001\u30DC\u30FC\u30C8\u3067\u8FD1\u9053\u3059\u308B\u304B\u306E\u9078\u629E\u3002"
  m_layout: "\u5E83\u3055: 28\xD724m\n\u30AE\u30DF\u30C3\u30AF: \u30D0\u30F3\u30D1\u30FC\xD72\u3001\u79FB\u52D5\u5E8A\xD71\n\u751F\u6210\u30A8\u30EA\u30A2: 6\u304B\u6240(\u77E9\u5F628\xD73\u3001\u77E9\u5F628\xD73\u3001\u5186\u5F62 \u534A\u5F841.5\u3001\u5186\u5F62 \u534A\u5F841.5\u3001\u5186\u5F62 \u534A\u5F841.5\u3001\u5186\u5F62 \u534A\u5F841.5)\n\u76E4\u9762\u306E\u7A4D\u307F\u6728\u306E\u4E0A\u9650: 24\u500B"
