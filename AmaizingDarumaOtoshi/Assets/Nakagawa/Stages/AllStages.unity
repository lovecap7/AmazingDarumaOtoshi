  m_concept: "\u4E2D\u592E\u306E\u672C\u306E\u4E0A\u306B\u3001\u307F\u304B\u3093\u3092\u8F09\u305B\u308B\u3088\u3046\u306A\u56DE\u8EE2\u76C6\u3002\u56DB\u65B9\u306E\u5C0F\u3055\u306A\u672C\u306E\u5CF6\u3068\u3001\u7D30\u3044\u681E\u306E\u6A4B\u3067\u3064\u306A\u304C\u3063\u3066\u3044\u308B\u3002"
  m_expectedFlow: "\u7A4D\u307F\u6728\u306F\u4E2D\u592E\u306E\u56DE\u8EE2\u76C6\u306E\u4E0A\u306B\u6E67\u304D\u3001\u56DE\u308A\u306A\u304C\u3089\u6D41\u308C\u3066\u3044\u304F\u3002\u5404\u81EA\u306E\u5CF6\u304B\u3089\u6A4B\u3092\u6E21\u3063\u3066\u53D6\u308A\u306B\u884C\u304F\u304C\u3001\u6A4B\u306E\u4E21\u5074\u306F\u5D16\u306A\u306E\u3067\u3001\u6E21\u3063\u3066\u3044\u308B\u6700\u4E2D\u306B\u6483\u305F\u308C\u308B\u3068\u9003\u3052\u5834\u304C\u306A\u3044\u3002\u56DE\u8EE2\u76C6\u306E\u4E0A\u3067\u306F\u5F3E\u304C\u66F2\u304C\u308B\u306E\u3067\u3001\u5CF6\u304B\u3089\u76C6\u306E\u4E0A\u306E\u76F8\u624B\u3092\u72D9\u3046\u306B\u306F\u66F2\u304C\u308A\u3092\u8AAD\u3080\u5FC5\u8981\u304C\u3042\u308B\u3002"
  m_layout: "\u5E83\u3055: 34\xD734m\n\u30AE\u30DF\u30C3\u30AF: \u56DE\u8EE2\u53F0\xD71\n\u751F\u6210\u30A8\u30EA\u30A2: 7\u304B\u6240(\u5186\u5F62 \u534A\u5F843\u3001\u77E9\u5F623\xD74\u3001\u77E9\u5F623\xD74\u3001\u77E9\u5F624\xD73\u3001\u77E9\u5F624\xD73\u3001\u5186\u5F62 \u534A\u5F841.5\u3001\u5186\u5F62 \u534A\u5F841.5)\n\u76E4\u9762\u306E\u7A4D\u307F\u6728\u306E\u4E0A\u9650: 22\u500B"
