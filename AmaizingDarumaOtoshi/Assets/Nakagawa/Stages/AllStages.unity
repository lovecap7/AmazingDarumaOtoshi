  m_id: Stage05
  m_title: "\u3061\u3083\u3076\u53F0\u8FD4\u3057"
  m_concept: "\u5357\u5074\u3060\u3051\u58C1\u306E\u306A\u3044\u5927\u304D\u306A\u672C\u306E\u4E0A\u3002\u5317\u306E\u9685\u306E\u6247\u98A8\u6A5F\u4E8C\u53F0\u304C\u3001\u3061\u3083\u3076\u53F0\u3092\u3072\u3063\u304F\u308A\u8FD4\u3059\u3088\u3046\u306A\u7A81\u98A8\u3092\u5357\u306E\u5D16\u3078\u659C\u3081\u306B\u5439\u304D\u3064\u3051\u308B\u3002"
  m_expectedFlow: "\u98A8\u306F\u5317\u306E\u9685\u304B\u3089\u5357\u306E\u5D16\u3078\u5411\u304B\u3063\u3066\u5439\u304F\u306E\u3067\u3001\u5357\u3078\u884C\u304F\u307B\u3069\u843D\u4E0B\u306E\u5371\u967A\u304C\u9AD8\u3044\u3002\u88DC\u7D66\u6240\u306F\u98A8\u4E0A\u306E\u5317\u306E\u58C1\u969B\u3068\u3001\u5D16\u306B\u8FD1\u3044\u5357\u306E\u4E2D\u592E\u3002\u5B89\u5168\u306A\u5317\u3067\u5730\u9053\u306B\u96C6\u3081\u308B\u304B\u3001\u5D16\u969B\u306E\u88DC\u7D66\u6240\u3067\u4E00\u6C17\u306B\u7A3C\u3050\u304B\u306E\u9078\u629E\u306B\u306A\u308B\u3002\u4E2D\u592E\u306E\u30D0\u30F3\u30D1\u30FC\u306B\u306F\u3058\u304B\u308C\u3066\u98A8\u306B\u4E57\u308B\u3068\u3001\u305D\u306E\u307E\u307E\u5D16\u307E\u3067\u904B\u3070\u308C\u308B\u3002"
  m_layout: "\u5E83\u3055: 32\xD725m\n\u30AE\u30DF\u30C3\u30AF: \u6247\u98A8\u6A5F\xD72\u3001\u30D0\u30F3\u30D1\u30FC\xD73\n\u751F\u6210\u30A8\u30EA\u30A2: 7\u304B\u6240(\u77E9\u5F6210\xD73\u3001\u5186\u5F62 \u534A\u5F842.5\u3001\u77E9\u5F6210\xD72\u3001\u5186\u5F62 \u534A\u5F842\u3001\u5186\u5F62 \u534A\u5F842\u3001\u5186\u5F62 \u534A\u5F841.6\u3001\u5186\u5F62 \u534A\u5F841.6)\n\u76E4\u9762\u306E\u7A4D\u307F\u6728\u306E\u4E0A\u9650: 26\u500B"
