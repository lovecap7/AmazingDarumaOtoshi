  m_id: DebugStage57
  m_title: "\u8239\u9996\u306E\u7A81\u98A8"
  m_concept: "\u6771\u3078\u5411\u304B\u3063\u3066\u7D30\u304F\u306A\u3063\u3066\u3044\u304F\u8239\u9996\u306E\u30C7\u30C3\u30AD\u3002\u624B\u3059\u308A\u306F\u897F\u3068\u5357\u5317\u306B\u3057\u304B\u306A\u304F\u3001\u8239\u9996\u306F\u6D77(\u5D16)\u3002\u897F\u306E\u6247\u98A8\u6A5F\u304C\u5357\u5317\u306B\u5F80\u5FA9\u3057\u306A\u304C\u3089\u8239\u9996\u3078\u5411\u3051\u3066\u7A81\u98A8\u3092\u9001\u308B\u3002\u7532\u677F\u306B\u306F\u30AD\u30E3\u30D7\u30B9\u30BF\u30F3\u306E\u3088\u3046\u306A\u30D0\u30F3\u30D1\u30FC\u3002"
  m_expectedFlow: "\u98A8\u306F\u897F\u304B\u3089\u8239\u9996\u3078\u5439\u304D\u3001\u8239\u9996\u3078\u884C\u304F\u307B\u3069\u8DB3\u5834\u304C\u7D30\u304F\u306A\u308B\u3002\u8239\u9996\u306E\u5148\u7AEF\u306E\u88DC\u7D66\u6240\u306F\u7A4D\u307F\u6728\u304C\u591A\u3044\u304C\u3001\u98A8\u3068\u30D0\u30F3\u30D1\u30FC\u306B\u62BC\u3055\u308C\u308B\u3068\u6D77\u3078\u843D\u3061\u308B\u3002\u98A8\u4E0A\u306E\u897F\u304B\u3089\u6483\u3064\u5F3E\u306F\u4F38\u3073\u3001\u98A8\u4E0B\u304B\u3089\u6483\u3061\u8FD4\u3059\u5F3E\u306F\u62BC\u3057\u623B\u3055\u308C\u308B\u3002\u8239\u9996\u306E\u6BB5\u306E\u89D2\u306B\u8FFD\u3044\u8A70\u3081\u308C\u3070\u3001\u98A8\u304C\u52DD\u624B\u306B\u843D\u3068\u3057\u3066\u304F\u308C\u308B\u3002"
  m_layout: "\u5E83\u3055: 31\xD722m\n\u30AE\u30DF\u30C3\u30AF: \u6247\u98A8\u6A5F\xD71\u3001\u30D0\u30F3\u30D1\u30FC\xD73\n\u751F\u6210\u30A8\u30EA\u30A2: 6\u304B\u6240(\u5186\u5F62 \u534A\u5F842\u3001\u77E9\u5F623\xD76\u3001\u5186\u5F62 \u534A\u5F841.2\u3001\u5186\u5F62 \u534A\u5F841.2\u3001\u77E9\u5F628\xD72\u3001\u77E9\u5F628\xD72)\n\u76E4\u9762\u306E\u7A4D\u307F\u6728\u306E\u4E0A\u9650: 24\u500B"
