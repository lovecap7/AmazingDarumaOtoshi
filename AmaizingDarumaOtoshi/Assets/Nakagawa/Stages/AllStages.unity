  m_title: "\u6D41\u3057\u53F0"
  m_concept: "\u4E2D\u592E\u306B\u6D41\u3057\u306E\u7A74\u304C\u7A7A\u3044\u305F\u8ABF\u7406\u53F0\u3002\u897F\u306E\u58C1\u969B\u3092\u63DB\u6C17\u6247\u306E\u98A8\u304C\u4E0A\u4E0B\u306B\u5F80\u5FA9\u3057\u3001\u6771\u306E\u5D16\u3078\u5411\u304B\u3063\u3066\u5439\u304D\u7D9A\u3051\u308B\u3002"
  m_expectedFlow: "\u7A74\u306E\u307E\u308F\u308A\u3092\u56DE\u308B\u53E3\u306E\u5B57\u306E\u901A\u8DEF\u3067\u3001\u6771\u3078\u884C\u304F\u307B\u3069\u98A8\u4E0B\u3067\u5D16\u304C\u8FD1\u3044\u3002\u98A8\u4E0A(\u897F)\u304B\u3089\u6483\u3064\u5F3E\u306F\u98A8\u306B\u4E57\u3063\u3066\u4F38\u3073\u3001\u98A8\u4E0B\u304B\u3089\u306E\u5F3E\u306F\u62BC\u3057\u623B\u3055\u308C\u308B\u3002\u7A74\u306E\u7E01\u306E\u88DC\u7D66\u6240\u306F\u843D\u3061\u308B\u5371\u967A\u3068\u96A3\u308A\u5408\u308F\u305B\u3002\u98A8\u306E\u5F80\u5FA9\u306E\u5207\u308C\u76EE\u3092\u8AAD\u3093\u3067\u653B\u3081\u8FBC\u3080\u3002"
  m_layout: "\u5E83\u3055: 29\xD722m\n\u30AE\u30DF\u30C3\u30AF: \u6247\u98A8\u6A5F\xD71\u3001\u30D0\u30F3\u30D1\u30FC\xD72\n\u751F\u6210\u30A8\u30EA\u30A2: 6\u304B\u6240(\u77E9\u5F624\xD76\u3001\u77E9\u5F623\xD76\u3001\u77E9\u5F623\xD76\u3001\u77E9\u5F6214\xD710\u3001\u5186\u5F62 \u534A\u5F842\u3001\u5186\u5F62 \u534A\u5F841.8)\n\u76E4\u9762\u306E\u7A4D\u307F\u6728\u306E\u4E0A\u9650: 24\u500B"
