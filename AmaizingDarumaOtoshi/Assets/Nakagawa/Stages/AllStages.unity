  m_concept: "\u6771\u897F\u306B\u9577\u3044\u95D8\u6280\u5834\u306E\u4E21\u7AEF\u304B\u3089\u3001\u4E2D\u592E\u3078\u5411\u304B\u3063\u3066\u6247\u98A8\u6A5F\u304C\u98A8\u3092\u9001\u308B\u3002"
