  m_title: "\u30B4\u30F3\u30C9\u30E9\u306E\u4E57\u308A\u7D99\u304E"
  m_concept: "\u5317\u306E\u96EA\u539F\u304B\u3089\u5357\u3078\u4E09\u672C\u306E\u5C3E\u6839\u304C\u4F38\u3073\u3001\u5C3E\u6839\u306E\u9593\u306E\u7D30\u3044\u8C37\u3092\u30B4\u30F3\u30C9\u30E9(\u79FB\u52D5\u5E8A)\u304C\u8C37\u306E\u5E45\u3044\u3063\u3071\u3044\u3067\u5357\u5317\u306B\u5F80\u5FA9\u3059\u308B\u3002\u6771\u897F\u306E\u5C3E\u6839\u306E\u5357\u306E\u7AEF\u3069\u3046\u3057\u3092\u30EF\u30FC\u30D7\u30B2\u30FC\u30C8\u304C\u3064\u306A\u3050\u3002"
  m_expectedFlow: "\u5C3E\u6839\u3069\u3046\u3057\u306F\u5317\u306E\u96EA\u539F\u3092\u56DE\u308C\u3070\u3064\u306A\u304C\u3063\u3066\u3044\u308B\u304C\u3001\u30B4\u30F3\u30C9\u30E9\u304C\u6765\u305F\u6240\u306A\u3089\u8C37\u3092\u4E00\u6B69\u3067\u6E21\u308C\u308B\u8FD1\u9053\u306B\u306A\u308B\u3002\u30B4\u30F3\u30C9\u30E9\u3092\u5F85\u3064\u9593\u306B\u6483\u305F\u308C\u308B\u3068\u8C37\u3078\u843D\u3061\u308B\u3002\u6771\u897F\u306E\u5C3E\u6839\u306E\u5357\u306E\u7AEF\u306E\u30B2\u30FC\u30C8\u3067\u4E00\u6C17\u306B\u53CD\u5BFE\u5074\u3078\u884C\u3051\u308B\u304C\u3001\u51FA\u53E3\u3067\u5F85\u3061\u4F0F\u305B\u3055\u308C\u3084\u3059\u3044\u3002\u4E2D\u592E\u306E\u5C3E\u6839\u306F\u4E21\u5074\u306E\u8C37\u304B\u3089\u72D9\u308F\u308C\u308B\u6FC0\u6226\u533A\u3002"
  m_layout: "\u5E83\u3055: 30\xD724m\n\u30AE\u30DF\u30C3\u30AF: \u79FB\u52D5\u5E8A\xD72\u3001\u30EF\u30FC\u30D7\u30B2\u30FC\u30C8\xD72\n\u751F\u6210\u30A8\u30EA\u30A2: 7\u304B\u6240(\u5186\u5F62 \u534A\u5F842\u3001\u77E9\u5F626\xD72\u3001\u5186\u5F62 \u534A\u5F841.5\u3001\u5186\u5F62 \u534A\u5F841.5\u3001\u77E9\u5F628\xD73\u3001\u5186\u5F62 \u534A\u5F841.2\u3001\u5186\u5F62 \u534A\u5F841.2)\n\u76E4\u9762\u306E\u7A4D\u307F\u6728\u306E\u4E0A\u9650: 24\u500B"
