  m_concept: "\u4E2D\u592E\u306B\u30D0\u30F3\u30D1\u30FC\u3092\u683C\u5B50\u72B6\u306B\u4E26\u3079\u305F\u7E26\u9577\u306E\u30DB\u30FC\u30EB\u3002\u88DC\u7D66\u6240\u306F\u5357\u5317\u306E\u7AEF\u3002"
