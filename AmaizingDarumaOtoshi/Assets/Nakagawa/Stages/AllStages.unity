  m_concept: "\u8ABF\u7406\u53F0\u306B\u7F6E\u3044\u305F\u7D30\u9577\u3044\u307E\u306A\u677F\u306E\u4E0A\u3002\u9577\u3044\u8FBA\u306B\u306F\u7E01(\u58C1)\u304C\u3042\u308A\u3001\u77ED\u3044\u8FBA\u306E\u5148\u306F\u8ABF\u7406\u53F0\u3078\u771F\u3063\u9006\u3055\u307E\u3002\u91CE\u83DC\u306E\u3088\u3046\u306B\u4E26\u3093\u30604\u3064\u306E\u30D0\u30F3\u30D1\u30FC\u304C\u4E2D\u592E\u3092\u56F2\u3080\u3002"
  m_expectedFlow: "\u6771\u897F\u306E\u7AEF\u306F\u5D16\u306A\u306E\u3067\u3001\u7AEF\u306B\u8FD1\u3044\u88DC\u7D66\u6240\u306F\u7A4D\u307F\u6728\u304C\u6E67\u3044\u3066\u3082\u53D6\u308A\u306B\u884C\u304F\u306E\u304C\u6016\u3044\u3002\u4E2D\u592E\u306E\u88DC\u7D66\u6240\u306F\u30D0\u30F3\u30D1\u30FC\u306E\u9593\u306B\u3042\u308A\u3001\u306F\u3058\u304B\u308C\u305F\u5F3E\u304C\u7E01\u3067\u8DF3\u306D\u8FD4\u3063\u3066\u623B\u3063\u3066\u304F\u308B\u3002\u7AEF\u3078\u62BC\u3057\u51FA\u3059\u304B\u3001\u4E2D\u592E\u3067\u8DF3\u5F3E\u3092\u6D74\u3073\u308B\u304B\u306E\u99C6\u3051\u5F15\u304D\u3002"
  m_layout: "\u5E83\u3055: 26\xD720m\n\u30AE\u30DF\u30C3\u30AF: \u30D0\u30F3\u30D1\u30FC\xD74\n\u751F\u6210\u30A8\u30EA\u30A2: 6\u304B\u6240(\u5186\u5F62 \u534A\u5F842.5\u3001\u77E9\u5F623\xD76\u3001\u77E9\u5F623\xD76\u3001\u77E9\u5F626\xD73\u3001\u77E9\u5F626\xD73\u3001\u5186\u5F62 \u534A\u5F841.6)\n\u76E4\u9762\u306E\u7A4D\u307F\u6728\u306E\u4E0A\u9650: 24\u500B"
