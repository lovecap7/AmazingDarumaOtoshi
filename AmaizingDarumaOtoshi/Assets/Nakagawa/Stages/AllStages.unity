  m_title: "\u5B9A\u898F\u306E\u6A4B"
  m_concept: "\u6771\u897F\u306E\u6559\u79D1\u66F8\u3092\u4E09\u672C\u306E\u5B9A\u898F\u304C\u3064\u306A\u3050\u3002\u771F\u3093\u4E2D\u306E\u5B9A\u898F\u306E\u9014\u4E2D\u306B\u306F\u5C0F\u3055\u306A\u56DE\u8EE2\u53F0\u306E\u4ED8\u3044\u305F\u6D88\u3057\u30B4\u30E0\u306E\u5CF6\u3002"
  m_expectedFlow: "\u81EA\u5206\u306E\u6559\u79D1\u66F8\u306E\u4E0A\u3067\u7A4D\u307F\u6728\u3092\u96C6\u3081\u3001\u7D30\u3044\u5B9A\u898F\u3092\u6E21\u3063\u3066\u653B\u3081\u8FBC\u3080\u3002\u5B9A\u898F\u306E\u4E21\u5074\u306F\u5D16\u306A\u306E\u3067\u3001\u6483\u305F\u308C\u3066\u907F\u3051\u308B\u3068\u843D\u3061\u308B\u3002\u4E2D\u592E\u306E\u5CF6\u306E\u56DE\u8EE2\u53F0\u306B\u4E57\u308B\u3068\u6D41\u3055\u308C\u3066\u5B9A\u898F\u304B\u3089\u5916\u308C\u3084\u3059\u3044\u3002\u4E09\u672C\u306E\u3069\u306E\u5B9A\u898F\u304B\u3089\u653B\u3081\u308B\u304B\u306E\u8AAD\u307F\u5408\u3044\u3002"
  m_layout: "\u5E83\u3055: 34\xD718m\n\u30AE\u30DF\u30C3\u30AF: \u56DE\u8EE2\u53F0\xD71\n\u751F\u6210\u30A8\u30EA\u30A2: 6\u304B\u6240(\u5186\u5F62 \u534A\u5F842\u3001\u77E9\u5F624\xD74\u3001\u77E9\u5F624\xD74\u3001\u77E9\u5F628\xD73.5\u3001\u77E9\u5F628\xD73.5\u3001\u77E9\u5F626\xD72.5)\n\u76E4\u9762\u306E\u7A4D\u307F\u6728\u306E\u4E0A\u9650: 22\u500B"
