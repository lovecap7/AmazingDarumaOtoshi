  m_title: "\u7E01\u5074\u306E\u677F\u306E\u9593"
  m_concept: "\u969C\u5B50\u306E\u524D\u306E\u7D30\u9577\u3044\u677F\u306E\u9593\u3002\u5357\u3068\u6771\u897F\u306F\u5EAD\u3078\u843D\u3061\u308B\u5D16\u3002\u897F\u306E\u7AEF\u306E\u6247\u98A8\u6A5F\u304C\u9996\u3092\u632F\u308B\u3088\u3046\u306B\u5357\u5317\u3078\u5F80\u5FA9\u3057\u3001\u6771\u3078\u98A8\u3092\u9001\u308B\u3002"
  m_expectedFlow: "\u98A8\u306F\u897F\u304B\u3089\u6771\u3078\u5439\u304D\u629C\u3051\u308B\u306E\u3067\u3001\u6771\u306E\u7AEF\u307B\u3069\u843D\u3061\u3084\u3059\u3044\u3002\u5357\u306E\u7E01\u3082\u5D16\u306A\u306E\u3067\u3001\u98A8\u306B\u6D41\u3055\u308C\u306A\u304C\u3089\u6483\u3061\u5408\u3046\u3068\u8DB3\u5143\u304C\u5371\u3046\u3044\u3002\u88DC\u7D66\u6240\u306F\u969C\u5B50\u306E\u524D\u30FB\u5EAD\u5074\u306E\u7E01\u30FB\u6771\u306E\u7AEF\u306B\u5206\u304B\u308C\u3001\u98A8\u4E0A\u306E\u897F\u3092\u53D6\u3063\u305F\u4EBA\u304C\u6709\u5229\u306B\u306A\u308B\u3002"
  m_layout: "\u5E83\u3055: 36\xD713m\n\u30AE\u30DF\u30C3\u30AF: \u6247\u98A8\u6A5F\xD71\u3001\u30D0\u30F3\u30D1\u30FC\xD72\n\u751F\u6210\u30A8\u30EA\u30A2: 6\u304B\u6240(\u5186\u5F62 \u534A\u5F841.5\u3001\u77E9\u5F623\xD78\u3001\u77E9\u5F6210\xD73\u3001\u77E9\u5F628\xD73\u3001\u5186\u5F62 \u534A\u5F841.8\u3001\u5186\u5F62 \u534A\u5F841.6)\n\u76E4\u9762\u306E\u7A4D\u307F\u6728\u306E\u4E0A\u9650: 24\u500B"
