  m_Script: {fileID: 11500000, guid: 2e7d0403be9a2b0418d7666136698b95, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Nakagawa.StageInfo
  m_id: Stage18
  m_title: "\u3082\u3093\u3058\u3083\u306E\u9244\u677F"
  m_concept: "\u4E0B\u753A\u306E\u3082\u3093\u3058\u3083\u713C\u304D\u5C4B\u306E\u9244\u677F\u306E\u4E0A\u3002\u56DB\u65B9\u306F\u9244\u677F\u306E\u91D1\u67A0(\u58C1)\u306B\u56F2\u307E\u308C\u3001\u6771\u897F\u306E\u7AEF\u8FD1\u304F\u306B\u306F\u30D8\u30E9\u3067\u5207\u308A\u8FBC\u3093\u3060\u3088\u3046\u306A\u7D30\u3044\u6E9D\u304C\u5357\u5317\u306B\u8D70\u308B\u3002\u4E2D\u592E\u306B\u306F\u6CB9\u306F\u306D\u306E\u3088\u3046\u306A\u30D0\u30F3\u30D1\u30FC\u304C\u3072\u3068\u3064\u3002"
  m_expectedFlow: "\u51FA\u73FE\u4F4D\u7F6E\u306F\u56DB\u9685\u3067\u3001\u88DC\u7D66\u6240\u306F\u4E2D\u592E\u306E\u5E83\u3044\u9244\u677F\u306B\u96C6\u307E\u308B\u3002\u6E9D\u306E\u5916\u5074\u306E\u7D30\u3044\u901A\u8DEF\u3078\u306F\u5357\u5317\u306E\u901A\u8DEF\u304B\u3089\u56DE\u308A\u8FBC\u3080\u3057\u304B\u306A\u3044\u3002\u6E9D\u306B\u5411\u3051\u3066\u6483\u3063\u305F\u5F3E\u306F\u5411\u3053\u3046\u5074\u306E\u5D16\u3067\u8DF3\u306D\u8FD4\u308A\u3001\u62BC\u3055\u308C\u3066\u6E9D\u306B\u843D\u3061\u305F\u4F53\u306F\u623B\u308C\u306A\u3044\u3002\u4E2D\u592E\u306E\u30D0\u30F3\u30D1\u30FC\u306E\u307E\u308F\u308A\u3067\u306E\u88DC\u7D66\u6240\u306E\u53D6\u308A\u5408\u3044\u3068\u3001\u6E9D\u969B\u3067\u306E\u62BC\u3057\u51FA\u3057\u5408\u3044\u304C\u5C71\u5834\u3002"
  m_layout: "\u5E83\u3055: 29\xD722m\n\u30AE\u30DF\u30C3\u30AF: \u30D0\u30F3\u30D1\u30FC\xD71\n\u751F\u6210\u30A8\u30EA\u30A2: 7\u304B\u6240(\u77E9\u5F624\xD76\u3001\u77E9\u5F624\xD76\u3001\u77E9\u5F624\xD76\u3001\u77E9\u5F624\xD76\u3001\u77E9\u5F626\xD79\u3001\u77E9\u5F623\xD712\u3001\u77E9\u5F623\xD712)\n\u76E4\u9762\u306E\u7A4D\u307F\u6728\u306E\u4E0A\u9650: 24\u500B"
