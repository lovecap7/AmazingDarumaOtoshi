  m_id: DebugStage11
  m_title: "\u5439\u304D\u3055\u3089\u3057\u306E\u5D16"
  m_concept: "\u5317\u5074\u3060\u3051\u58C1\u304C\u3042\u308A\u3001\u5357\u5074\u306F\u5D16\u3002\u5317\u306E\u58C1\u969B\u3092\u6247\u98A8\u6A5F\u304C\u5F80\u5FA9\u3057\u3066\u5D16\u3078\u5411\u304B\u3046\u98A8\u3092\u9001\u308B\u3002\u5D16\u969B\u306B\u306F\u30D0\u30F3\u30D1\u30FC\u3002"
  m_expectedFlow: "\u98A8\u306F\u5E38\u306B\u5D16\u306E\u65B9\u5411\u3078\u5439\u304F\u306E\u3067\u3001\u5357\u5074\u306B\u7ACB\u3064\u307B\u3069\u843D\u4E0B\u306E\u5371\u967A\u304C\u9AD8\u3044\u3002\u88DC\u7D66\u6240\u306F\u98A8\u4E0A\u306E\u5317\u306E\u58C1\u969B\u306B\u3042\u308A\u3001\u5168\u54E1\u304C\u5317\u3078\u96C6\u307E\u3063\u3066\u62BC\u3057\u5408\u3046\u3002\u5D16\u969B\u306E\u30D0\u30F3\u30D1\u30FC\u306B\u306F\u3058\u304B\u308C\u308B\u3068\u98A8\u306B\u4E57\u3063\u3066\u5948\u843D\u3078\u4E00\u76F4\u7DDA\u3002\u98A8\u4E0B\u3078\u8FFD\u3044\u8FBC\u3080\u7ACB\u3061\u56DE\u308A\u304C\u6C7A\u3081\u624B\u3002"
  m_layout: "\u5E83\u3055: 26\xD721m\n\u30AE\u30DF\u30C3\u30AF: \u6247\u98A8\u6A5F\xD71\u3001\u30D0\u30F3\u30D1\u30FC\xD73\n\u751F\u6210\u30A8\u30EA\u30A2: 7\u304B\u6240(\u77E9\u5F6218\xD73\u3001\u5186\u5F62 \u534A\u5F842.5\u3001\u77E9\u5F628\xD73\u3001\u77E9\u5F623\xD76\u3001\u77E9\u5F623\xD76\u3001\u5186\u5F62 \u534A\u5F841.8\u3001\u5186\u5F62 \u534A\u5F841.8)\n\u76E4\u9762\u306E\u7A4D\u307F\u6728\u306E\u4E0A\u9650: 22\u500B"
