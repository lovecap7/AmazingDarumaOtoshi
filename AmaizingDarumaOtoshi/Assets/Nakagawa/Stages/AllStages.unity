  m_id: DebugStage47
  m_title: "\u89B3\u5BA2\u5E2D\u306E\u30A6\u30A7\u30FC\u30D6"
  m_concept: "\u5357\u5317\u306E\u89B3\u5BA2\u5E2D\u306E\u524D\u306B\u4E26\u3093\u3060\u305B\u308A\u4E0A\u304C\u308A\u5840\u304C\u3001\u30A6\u30A7\u30FC\u30D6\u306E\u3088\u3046\u306B\u9806\u756A\u306B\u7ACB\u3061\u4E0A\u304C\u308B\u3002\u6771\u306E\u6247\u98A8\u6A5F\u304C\u5357\u5317\u306B\u5F80\u5FA9\u3057\u306A\u304C\u3089\u897F\u3078\u98A8\u3092\u9001\u308B\u3002"
  m_expectedFlow: "\u5317\u3068\u5357\u306E\u30A6\u30A7\u30FC\u30D6\u306F\u9006\u5411\u304D\u306B\u6D41\u308C\u308B\u306E\u3067\u3001\u5840\u306E\u5207\u308C\u76EE\u306E\u4F4D\u7F6E\u304C\u5357\u5317\u3067\u9055\u3046\u3002\u5840\u306F\u8DF3\u3093\u3067\u3082\u8D8A\u3048\u3089\u308C\u305A\u3001\u89B3\u5BA2\u5E2D\u5074\u306E\u88DC\u7D66\u6240\u3078\u306F\u5207\u308C\u76EE\u3092\u901A\u3063\u3066\u5165\u308B\u3057\u304B\u306A\u3044\u3002\u4E2D\u592E\u306E\u5E2F\u306F\u6771\u304B\u3089\u306E\u98A8\u3067\u897F\u3078\u6D41\u3055\u308C\u3001\u98A8\u4E0A\u306E\u6771\u304B\u3089\u6483\u3064\u5F3E\u306F\u901F\u304F\u98DB\u3076\u3002"
  m_layout: "\u5E83\u3055: 32\xD724m\n\u30AE\u30DF\u30C3\u30AF: \u6247\u98A8\u6A5F\xD71\u3001\u305B\u308A\u4E0A\u304C\u308A\u5840\xD716\n\u751F\u6210\u30A8\u30EA\u30A2: 6\u304B\u6240(\u5186\u5F62 \u534A\u5F842\u3001\u5186\u5F62 \u534A\u5F841.5\u3001\u5186\u5F62 \u534A\u5F841.5\u3001\u77E9\u5F6210\xD72.5\u3001\u77E9\u5F6210\xD72.5\u3001\u5186\u5F62 \u534A\u5F841.2)\n\u76E4\u9762\u306E\u7A4D\u307F\u6728\u306E\u4E0A\u9650: 24\u500B"
