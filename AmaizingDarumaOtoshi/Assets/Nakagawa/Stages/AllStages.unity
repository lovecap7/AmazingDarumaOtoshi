  m_layout: "\u5E83\u3055: 28\xD728m\n\u30AE\u30DF\u30C3\u30AF: \u306A\u3057\n\u751F\u6210\u30A8\u30EA\u30A2: 4\u304B\u6240(\u77E9\u5F625\xD75\u3001\u77E9\u5F625\xD75\u3001\u77E9\u5F625\xD75\u3001\u77E9\u5F625\xD75)\n\u76E4\u9762\u306E\u7A4D\u307F\u6728\u306E\u4E0A\u9650: 28\u500B"
