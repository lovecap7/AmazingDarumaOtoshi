  m_concept: "\u4E2D\u592E\u306B\u9AD8\u901F\u306E\u56DE\u8EE2\u53F0\u3001\u56DB\u9685\u306E\u6247\u98A8\u6A5F\u304C\u4E2D\u592E\u3078\u5411\u3051\u3066\u98A8\u3092\u9001\u308B\u3002\u88DC\u7D66\u6240\u306F\u5404\u8FBA\u306E\u4E2D\u592E\u306E\u7121\u98A8\u5730\u5E2F\u3002"
  m_expectedFlow: "\u98A8\u304C\u5168\u54E1\u3092\u4E2D\u592E\u306E\u56DE\u8EE2\u53F0\u3078\u5F15\u304D\u5BC4\u305B\u3001\u53F0\u306E\u4E0A\u3067\u306F\u9AD8\u901F\u56DE\u8EE2\u3067\u5F3E\u3082\u4F53\u3082\u5927\u304D\u304F\u6D41\u3055\u308C\u308B\u3002\u88DC\u7D66\u6240\u306F\u98A8\u306E\u5F53\u305F\u3089\u306A\u3044\u5916\u5074\u306B\u3042\u308B\u306E\u3067\u3001\u5916\u3067\u7A4D\u307F\u6728\u3092\u96C6\u3081\u3001\u4E2D\u592E\u3078\u6D41\u3055\u308C\u3066\u304D\u305F\u76F8\u624B\u3092\u72D9\u3046\u306E\u304C\u5B9A\u77F3\u3002\u53F0\u306E\u4E0A\u3067\u306E\u6DF7\u6226\u306B\u5DFB\u304D\u8FBC\u307E\u308C\u308B\u304B\u3069\u3046\u304B\u304C\u5206\u304B\u308C\u76EE\u3002"
  m_layout: "\u5E83\u3055: 32\xD732m\n\u30AE\u30DF\u30C3\u30AF: \u6247\u98A8\u6A5F\xD74\u3001\u56DE\u8EE2\u53F0\xD71\n\u751F\u6210\u30A8\u30EA\u30A2: 4\u304B\u6240(\u5186\u5F62 \u534A\u5F842\u3001\u5186\u5F62 \u534A\u5F842\u3001\u5186\u5F62 \u534A\u5F842\u3001\u5186\u5F62 \u534A\u5F842)\n\u76E4\u9762\u306E\u7A4D\u307F\u6728\u306E\u4E0A\u9650: 26\u500B"
