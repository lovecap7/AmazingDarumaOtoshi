  m_concept: "\u30AE\u30DF\u30C3\u30AF\u306A\u3057\u306E\u6B63\u65B9\u5F62\u306E\u95D8\u6280\u5834\u3002\u5168\u30B9\u30C6\u30FC\u30B8\u306E\u57FA\u6E96\u3068\u306A\u308B\u3001\u64CD\u4F5C\u3068\u99C6\u3051\u5F15\u304D\u306E\u57FA\u672C\u3060\u3051\u3067\u6226\u3046\u821E\u53F0\u3002"
